<scroll-view scroll-y class="page">
  <!-- 顶部 -->
  <view class="header">
    <text class="emoji-top">🔮</text>
    <text class="title">关系参考结果</text>
    <text class="subtitle">根据输入内容生成的参考结果</text>
  </view>

  <!-- 头像区 -->
  <view class="avatar-section">
    <view class="avatar-item">
      <view class="avatar-circle"><text>{{data.myInfo.name[0] || '我'}}</text></view>
      <text class="avatar-name">{{data.myInfo.name || '我'}}</text>
    </view>
    <view class="vs-divider"><text class="vs-text">×</text></view>
    <view class="avatar-item">
      <view class="avatar-circle"><text>{{data.yourInfo.name[0] || 'TA'}}</text></view>
      <text class="avatar-name">{{data.yourInfo.name || 'TA'}}</text>
    </view>
  </view>

  <!-- 关系指数 -->
  <view class="result-card">
    <view class="result-header">
      <text class="result-label">关系指数</text>
      <view class="risk-tag" style="color:{{riskColor}};border-color:{{riskColor}}50;background:{{riskColor}}15">{{riskLabel}}</view>
    </view>
    <view class="index-display">
      <text class="index-number" style="color:{{riskColor}}">{{result.niyuanIndex}}</text>
      <text class="index-suffix">分</text>
    </view>
    <view class="divider" />
    <view class="match-row">
      <view class="match-item">
        <text class="match-value" style="color:#4ADE80">{{result.matchScore}}%</text>
        <text class="match-label">契合度</text>
      </view>
      <view class="match-divider" />
      <view class="match-item">
        <text class="match-value" style="color:#F59E0B">{{result.confessionProb}}%</text>
        <text class="match-label">积极度</text>
      </view>
      <view class="match-divider" />
      <view class="match-item">
        <text class="match-value" style="color:#EF4444">{{result.cheatingRisk}}%</text>
        <text class="match-label">波动度</text>
      </view>
    </view>
  </view>

  <!-- 一句话 -->
  <view class="summary-card">
    <text class="summary-text">{{result.summary}}</text>
  </view>

  <!-- 结果说明 -->
  <view class="detail-card">
    <text class="detail-title">📊 结果说明</text>
    <view class="detail-section">
      <text class="section-title">当前提示</text>
      <text class="section-text">{{result.problems}}</text>
    </view>
    <view class="detail-section">
      <text class="section-title">参考说明</text>
      <text class="section-text">{{result.prediction}}</text>
    </view>
  </view>

  <!-- 建议 -->
  <view class="advice-card">
    <text class="detail-title">✨ 建议</text>
    <view wx:for="{{result.suggestions}}" wx:key="index" class="advice-item">
      <text class="advice-num">{{index + 1}}</text>
      <text class="advice-text">{{item}}</text>
    </view>
  </view>

  <!-- 操作 -->
  <view class="action-section">
    <view class="btn-share" bindtap="onShare">📤 保存结果卡片</view>
    <view class="btn-retry" bindtap="onBack">🔄 再测一次</view>
  </view>

  <!-- 更多内容提示 -->
  <view class="pay-hint">
    <text class="pay-emoji">🔒</text>
    <view class="pay-content">
      <text class="pay-title">更多内容敬请期待</text>
      <text class="pay-desc">后续会补充更完整的结果说明与展示内容</text>
      <view class="pay-btn">后续更新</view>
    </view>
  </view>

  <view class="bottom-space" />
</scroll-view>

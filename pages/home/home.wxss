/* 首页样式 - 梦幻渐变主题 */
.home-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF7F9 0%, #F8F5FB 40%, #F5F3F8 100%);
  display: flex;
  flex-direction: column;
}

.home-scroll {
  flex: 1;
  height: 100vh;
}

/* 个性化问候头部 */
.greeting-header {
  background: linear-gradient(135deg, rgba(232,168,191,0.2) 0%, rgba(184,164,216,0.15) 100%);
  padding: 40rpx 32rpx 56rpx;
  border-radius: 0 0 48rpx 48rpx;
  border: 1px solid rgba(232,168,191,0.2);
  border-top: none;
}

.greeting-user {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  overflow: hidden;
  border: 4rpx solid rgba(232,168,191,0.5);
  box-shadow: 0 0 20rpx rgba(232,168,191,0.3);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.greeting-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting-main {
  font-size: 40rpx;
  font-weight: 700;
  color: #7A6E7A;
  line-height: 1.3;
}

.greeting-sub {
  font-size: 28rpx;
  color: rgba(122,110,122,1.0);
  line-height: 1.4;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 32rpx;
  background: rgba(184,164,216,0.04);
  margin: -32rpx 32rpx 32rpx;
  border-radius: 32rpx;
  border: 1px solid rgba(184,164,216,0.15);
  box-shadow: 0 8rpx 32rpx rgba(184,164,216,0.1);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-icon {
  font-size: 56rpx;
}

.action-title {
  font-size: 26rpx;
  color: rgba(122,110,122,1.0);
}

/* 推荐测试区 */
.recommend-section {
  padding: 0 32rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #7A6E7A;
}

.section-more {
  font-size: 26rpx;
  color: #E8A8BF;
}

.test-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.test-card {
  background: rgba(184,164,216,0.04);
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1px solid rgba(184,164,216,0.15);
  transition: all 0.3s ease;
}

.test-card:active {
  background: rgba(255,255,255,0.6);
  border-color: rgba(232,168,191,0.3);
}

.test-card-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.test-emoji-wrap {
  width: 96rpx;
  height: 96rpx;
  background: rgba(232,168,191,0.15);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 1px solid rgba(232,168,191,0.2);
}

.test-emoji {
  font-size: 48rpx;
}

.test-header-info {
  flex: 1;
}

.test-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.test-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #7A6E7A;
}

.test-badge {
  background: linear-gradient(135deg, #E8A8BF 0%, #B8A4D8 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
}

.test-desc {
  font-size: 26rpx;
  color: rgba(122,110,122,1.0);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.test-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.test-meta {
  display: flex;
  gap: 24rpx;
}

.test-people,
.test-time {
  font-size: 24rpx;
  color: rgba(122,110,122,1.0);
}

.test-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #E8A8BF;
}

/* 底部空白 */
.home-bottom-spacer {
  height: 160rpx;
}

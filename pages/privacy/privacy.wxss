/* 隐私协议页 - 梦幻渐变主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF7F9 0%, #F8F5FB 40%, #F5F3F8 100%);
  display: flex;
  flex-direction: column;
}

.header {
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(232,168,191,0.1) 0%, transparent 100%);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #7A6E7A;
}

.content {
  flex: 1;
  padding: 0 40rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #7A6E7A;
  margin-bottom: 20rpx;
}

.section-text {
  display: block;
  font-size: 26rpx;
  color: rgba(122,110,122,1.0);
  line-height: 1.8;
}

.footer {
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(184,164,216,0.04);
  border-top: 1px solid rgba(184,164,216,0.15);
  display: flex;
  gap: 24rpx;
}

.agree-btn {
  flex: 1;
  padding: 28rpx;
  background: linear-gradient(135deg, #E8A8BF 0%, #B8A4D8 100%);
  border-radius: 32rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(232,168,191,0.3);
}

.disagree-btn {
  flex: 1;
  padding: 28rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 32rpx;
  color: rgba(122,110,122,1.0);
  font-size: 30rpx;
  text-align: center;
  border: 1px solid rgba(184,164,216,0.15);
}

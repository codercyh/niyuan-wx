/* 隐私协议页 - 梦幻渐变主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #FAEEFF 40%, #F3E8FF 100%);
  display: flex;
  flex-direction: column;
}

.header {
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
  background: linear-gradient(180deg, rgba(255,123,169,0.1) 0%, transparent 100%);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.content {
  flex: 1;
  padding: 0 40rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4A5A;
  margin-bottom: 20rpx;
}

.section-text {
  display: block;
  font-size: 26rpx;
  color: rgba(90,74,90,1.0);
  line-height: 1.8;
}

.footer {
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(155,107,255,0.04);
  border-top: 1px solid rgba(155,107,255,0.15);
  display: flex;
  gap: 24rpx;
}

.agree-btn {
  flex: 1;
  padding: 28rpx;
  background: linear-gradient(135deg, #FF7BA9 0%, #9B6BFF 100%);
  border-radius: 32rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(255,123,169,0.3);
}

.disagree-btn {
  flex: 1;
  padding: 28rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 32rpx;
  color: rgba(90,74,90,1.0);
  font-size: 30rpx;
  text-align: center;
  border: 1px solid rgba(155,107,255,0.15);
}

/* 结果卡片页 - 梦幻渐变主题 */

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #FAEEFF 40%, #F3E8FF 100%);
}

/* 卡片预览 */
.share-preview {
  margin: 40rpx;
  padding: 48rpx;
  background: rgba(155,107,255,0.04);
  border-radius: 32rpx;
  border: 1px solid rgba(155,107,255,0.15);
}

.share-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.share-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.share-result {
  font-size: 28rpx;
  color: #FF7BA9;
  margin-top: 8rpx;
}

.share-content {
  font-size: 26rpx;
  color: rgba(90,74,90,1.0);
  line-height: 1.8;
  text-align: center;
}

/* 操作按钮 */
.share-actions {
  padding: 0 40rpx 40rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF7BA9 0%, #9B6BFF 100%);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255,123,169,0.3);
}

.share-btn-icon {
  font-size: 40rpx;
}

/* 底部安全区域 */
.bottom-space {
  height: 200rpx;
}

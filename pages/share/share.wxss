/* 结果卡片页 - 梦幻渐变主题 */

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #FCEEEE 0%, #FFF0E8 40%, #E8F5EE 100%);
}

/* 卡片预览 */
.share-preview {
  margin: 40rpx;
  padding: 48rpx;
  background: rgba(124,196,160,0.04);
  border-radius: 32rpx;
  border: 1px solid rgba(124,196,160,0.15);
}

.share-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.share-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #5A4F56;
}

.share-result {
  font-size: 28rpx;
  color: #DC8DA8;
  margin-top: 8rpx;
}

.share-content {
  font-size: 26rpx;
  color: rgba(90,79,86,1.0);
  line-height: 1.8;
  text-align: center;
}

/* 操作按钮 */
.share-actions {
  padding: 0 40rpx 40rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #DC8DA8 0%, #7CC4A0 100%);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(220,141,168),0.3);
}

.share-btn-icon {
  font-size: 40rpx;
}

/* 底部安全区域 */
.bottom-space {
  height: 200rpx;
}

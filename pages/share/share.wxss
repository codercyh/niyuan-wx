/* 结果卡片页 - 梦幻渐变主题 */

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF6F6 0%, #FFF8F0 40%, #F0F8F4 100%);
}

/* 卡片预览 */
.share-preview {
  margin: 40rpx;
  padding: 48rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 32rpx;
  border: 1px solid rgba(157,212,184,0.15);
}

.share-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.share-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #6A6068;
}

.share-result {
  font-size: 28rpx;
  color: #E8A8BF;
  margin-top: 8rpx;
}

.share-content {
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
  line-height: 1.8;
  text-align: center;
}

/* 操作按钮 */
.share-actions {
  padding: 0 40rpx 40rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E8A8BF 0%, #9DD4B8 100%);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(232,168,191,0.3);
}

.share-btn-icon {
  font-size: 40rpx;
}

/* 底部安全区域 */
.bottom-space {
  height: 200rpx;
}

/* 结果卡片页 - 深色渐变主题 */

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* 卡片预览 */
.share-preview {
  margin: 40rpx;
  padding: 48rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 32rpx;
  border: 1px solid rgba(255,255,255,0.1);
}

.share-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.share-emoji {
  font-size: 96rpx;
  margin-bottom: 16rpx;
}

.share-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.share-result {
  font-size: 28rpx;
  color: #FF6B35;
  margin-top: 8rpx;
}

.share-content {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.8;
  text-align: center;
}

/* 操作按钮 */
.share-actions {
  padding: 0 40rpx 40rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  border-radius: 24rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(255,107,53,0.3);
}

.share-btn-icon {
  font-size: 40rpx;
}

/* 底部安全区域 */
.bottom-space {
  height: 200rpx;
}

<view class="page">
  <view class="header">
    <text class="title">📤 结果卡片</text>
    <text class="subtitle">保存图片或文案，方便自己查看</text>
  </view>

  <view class="poster-preview">
    <view class="poster-card">
      <view class="poster-header">
        <text class="poster-logo">🔮 结果记录</text>
      </view>
      <view class="poster-avatars">
        <view class="poster-avatar">
          <text class="avatar-emoji">{{data.myInfo.name}}</text>
          <text class="avatar-name">{{data.myInfo.name}}</text>
        </view>
        <view class="poster-vs"><text class="vs-emoji">×</text></view>
        <view class="poster-avatar">
          <text class="avatar-emoji">{{data.yourInfo.name}}</text>
          <text class="avatar-name">{{data.yourInfo.name}}</text>
        </view>
      </view>
      <view class="poster-result">
        <text class="poster-label">关系指数</text>
        <text class="poster-index">{{result.niyuanIndex}}分</text>
      </view>
      <view class="poster-footer">
        <text class="poster-tip">保存这张卡片，方便之后回看</text>
      </view>
    </view>
  </view>

  <view class="action-list">
    <view class="action-btn primary" bindtap="onSave">📥 保存卡片</view>
    <view class="action-btn" bindtap="onShare">🔄 复制文案</view>
  </view>

  <view class="tips">
    <text class="tips-title">使用提示</text>
    <text class="tips-item">• 可以保存图片留作记录</text>
    <text class="tips-item">• 也可以复制文案到备忘录</text>
    <text class="tips-item">• 结果内容仅供个人兴趣参考</text>
  </view>
</view>

<!-- 进入页面 -->
<view class="page auth-page">
  <!-- 顶部装饰 -->
  <view class="auth-header">
    <view class="app-logo">
      <text class="logo-icon">星</text>
      <text class="logo-text">测</text>
    </view>
    <text class="logo-slogan">看看兴趣，做做测试，保存记录</text>
  </view>

  <view class="auth-body">
    <!-- 已登录状态 -->
    <view wx:if="{{isLoggedIn}}" class="logged-in-section">
      <view class="user-avatar-large">
        <image src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      </view>
      <text class="user-name">{{userInfo.nickName}}</text>
      <text class="user-id">当前状态已保存</text>
      <button class="btn btn-primary" bindtap="handleContinue">继续使用</button>
      <button class="btn btn-text" bindtap="handleLogout">重新进入</button>
    </view>

    <!-- 未登录：登录表单 -->
    <view wx:elif="{{showLoginForm}}" class="login-form">
      <text class="form-title">{{loginMode === 'wechat' ? '微信登录' : '自定义昵称'}}</text>
      <text class="form-desc">{{loginMode === 'wechat' ? '确认你的头像和昵称' : '设置你的头像和昵称'}}</text>

      <!-- 头像 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image 
          class="avatar-img" 
          src="{{tempAvatarUrl || '/images/default-avatar.png'}}" 
          mode="aspectFill"
        />
        <view class="avatar-edit-icon">📷</view>
      </button>

      <!-- 昵称 -->
      <view class="nickname-wrap">
        <input 
          class="nickname-input"
          type="{{loginMode === 'wechat' ? 'nickname' : 'text'}}"
          placeholder="请输入昵称"
          maxlength="20"
          bindinput="onNicknameInput"
          value="{{tempNickName}}"
        />
      </view>

      <!-- 确认按钮 -->
      <button 
        class="btn btn-confirm" 
        bindtap="handleConfirmLogin"
        disabled="{{!tempNickName.trim()}}"
      >
        确认进入
      </button>

      <button class="btn btn-back" bindtap="handleBackToMain">返回</button>
    </view>

    <!-- 未登录：选择登录方式 -->
    <view wx:else class="login-section">
      <text class="login-title">欢迎使用</text>
      <text class="login-desc">选择一种方式开始使用</text>

      <button class="btn btn-wechat" bindtap="handleWechatLogin">
        微信登录
      </button>

      <button class="btn btn-custom" bindtap="handleCustomLogin">
        自定义昵称进入
      </button>

      <view class="privacy-section">
        <text class="privacy-text">
          继续即表示已阅读
          <navigator url="/pages/privacy/privacy" class="link">隐私说明</navigator>
        </text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="spinner">
      <view class="spinner-ring"></view>
    </view>
    <text class="loading-text">{{loadingText}}</text>
  </view>
</view>
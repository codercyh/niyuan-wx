/* 登录页 - 深色渐变主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

.auth-page {
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* 顶部装饰 */
.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  padding-bottom: 80rpx;
}

.app-logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 96rpx;
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255,107,53,0.4);
  border: 2rpx solid rgba(255,255,255,0.2);
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

/* 登录区域 */
.auth-body {
  padding: 0 48rpx;
}

/* 已登录状态 */
.logged-in-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,107,53,0.5);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.3);
}

.user-avatar-large image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* 未登录状态 */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.login-icon {
  font-size: 128rpx;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.login-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 24rpx;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

/* 按钮样式修复 */
.auth-body button {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
  margin: 0;
  line-height: 1.4;
}

.auth-body button::after {
  border: none;
}

.auth-body button text {
  font-size: inherit;
  font-weight: inherit;
}

.btn-text {
  background: transparent !important;
  color: rgba(255,255,255,0.6) !important;
  border: none !important;
  font-size: 28rpx !important;
}

.btn-text text {
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
}

/* 隐私政策 */
.privacy-section {
  margin-top: 40rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
}

.link {
  color: #FF6B35;
  font-weight: 500;
}

/* 加载状态 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,12,41,0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  z-index: 9999;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
}

.spinner-ring {
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(255,255,255,0.2);
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

/* 登录页 - 深色渐变主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

.auth-page {
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* ===== 顶部装饰 ===== */

.auth-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  padding-bottom: 80rpx;
}

.app-logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 96rpx;
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255,107,53,0.4);
  border: 2rpx solid rgba(255,255,255,0.2);
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
}

/* ===== 主体区域 ===== */

.auth-body {
  padding: 0 48rpx;
}

/* ===== 已登录状态 ===== */

.logged-in-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,107,53,0.5);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.3);
}

.user-avatar-large image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

/* ===== 未登录：选择方式 ===== */

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.login-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
  margin-bottom: 16rpx;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%) !important;
  border-radius: var(--radius-xl) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.3);
}

.btn-wechat::after {
  border: none;
}

.btn-wechat:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-custom {
  width: 100%;
  height: 96rpx;
  background: transparent !important;
  border: 2rpx solid rgba(255,255,255,0.3) !important;
  border-radius: var(--radius-xl) !important;
  color: rgba(255,255,255,0.8) !important;
  font-size: 32rpx !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.4;
}

.btn-custom::after {
  border: none;
}

.btn-custom:active {
  background: rgba(255,255,255,0.08) !important;
}

.btn-icon-login {
  font-size: 32rpx;
}

/* ===== 自定义登录表单 ===== */

.custom-login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.custom-login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  align-self: flex-start;
}

.avatar-picker {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-top: 16rpx;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,107,53,0.5);
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.3);
}

.avatar-edit-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #FF6B35, #FF006E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #302B63;
}

.edit-icon {
  font-size: 22rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: -16rpx;
}

.nickname-input-wrap {
  width: 100%;
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(255,255,255,0.15);
  border-radius: var(--radius-xl);
  padding: 0 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  background: transparent;
  border: none;
}

.nickname-input::placeholder {
  color: rgba(255,255,255,0.4);
}

.btn-login {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-button) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border-radius: var(--radius-xl) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.3);
}

.btn-login::after {
  border: none;
}

.btn-login:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-login[disabled] {
  opacity: 0.5 !important;
  box-shadow: none;
}

.btn-back-login {
  background: transparent !important;
  border: none !important;
  color: rgba(255,255,255,0.5) !important;
  font-size: 26rpx !important;
  margin-top: -16rpx;
}

.btn-back-login::after {
  border: none;
}

/* ===== 通用按钮样式 ===== */

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-button) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border-radius: var(--radius-xl) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.3);
}

.btn-primary::after {
  border: none;
}

.btn-text {
  background: transparent !important;
  color: rgba(255,255,255,0.6) !important;
  border: none !important;
  font-size: 28rpx !important;
}

.btn-text::after {
  border: none;
}

/* ===== 隐藏的头像选择按钮 ===== */

.hidden-avatar-btn {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
}

/* ===== 隐私政策 ===== */

.privacy-section {
  margin-top: 40rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
}

.link {
  color: #FF6B35;
  font-weight: 500;
}

/* ===== 加载状态 ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,12,41,0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  z-index: 9999;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
}

.spinner-ring {
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(255,255,255,0.2);
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}
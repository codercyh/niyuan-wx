/* 登录页 - 梦幻渐变主题 */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF6F6 0%, #FFF8F0 40%, #F0F8F4 100%);
}

.auth-page {
  background: linear-gradient(180deg, #FDF6F6 0%, #FFF8F0 40%, #F0F8F4 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.auth-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 已登录状态 ===== */

.logged-in-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.user-avatar-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(232,168,191,0.5);
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(232,168,191,0.3);
}

.user-avatar-large image {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #6A6068;
}

.user-id {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

/* ===== 选择登录方式 ===== */

.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.app-logo {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.logo-icon {
  font-size: 96rpx;
  width: 144rpx;
  height: 144rpx;
  background: linear-gradient(135deg, #E8A8BF 0%, #9DD4B8 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(232,168,191,0.4);
  border: 2rpx solid rgba(157,212,184,0.15);
}

.logo-text {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #E8A8BF 0%, #9DD4B8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #6A6068;
}

.login-desc {
  font-size: 28rpx;
  color: rgba(106,96,104,1.0);
  text-align: center;
  margin-bottom: 16rpx;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%) !important;
  border-radius: var(--radius-xl) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.3);
}

.btn-wechat::after {
  border: none;
}

.btn-wechat:active {
  opacity: 0.85;
}

.btn-custom {
  width: 100%;
  height: 96rpx;
  background: transparent !important;
  border: 2rpx solid rgba(157,212,184,0.15) !important;
  border-radius: var(--radius-xl) !important;
  color: rgba(106,96,104,1.0) !important;
  font-size: 32rpx !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.4;
}

.btn-custom::after {
  border: none;
}

.btn-custom:active {
  background: rgba(255,255,255,0.6) !important;
}

/* ===== 登录表单（头像+昵称） ===== */

.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: 6rpx solid rgba(232,168,191,0.5) !important;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(232,168,191,0.3);
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-edit-icon {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #E8A8BF, #9DD4B8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  border: 3rpx solid #E8DFFF;
  z-index: 2;
}

.nickname-wrap {
  width: 100%;
  background: rgba(255,255,255,0.6);
  border: 2rpx solid rgba(157,212,184,0.15);
  border-radius: var(--radius-xl);
  padding: 0 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
}

.nickname-input {
  width: 100%;
  height: 96rpx;
  font-size: 30rpx;
  color: #6A6068;
  background: transparent;
}

.nickname-input::placeholder {
  color: rgba(106,96,104,1.0);
}

.btn-confirm {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-button) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border-radius: var(--radius-xl) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(232,168,191,0.3);
}

.btn-confirm::after {
  border: none;
}

.btn-confirm:active {
  opacity: 0.85;
}

.btn-confirm[disabled] {
  opacity: 0.4 !important;
  box-shadow: none;
}

.btn-back {
  background: transparent !important;
  border: none !important;
  color: rgba(106,96,104,1.0) !important;
  font-size: 26rpx !important;
  margin: 0 !important;
  padding: 0 !important;
}

.btn-back::after {
  border: none;
}

/* ===== 通用按钮 ===== */

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--gradient-button) !important;
  color: #FFFFFF !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border-radius: var(--radius-xl) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  line-height: 1.4;
  box-shadow: 0 8rpx 32rpx rgba(232,168,191,0.3);
}

.btn-primary::after {
  border: none;
}

.btn-text {
  background: transparent !important;
  color: rgba(106,96,104,1.0) !important;
  border: none !important;
  font-size: 28rpx !important;
}

.btn-text::after {
  border: none;
}

/* ===== 隐私政策 ===== */

.privacy-section {
  margin-top: 40rpx;
}

.privacy-text {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
  text-align: center;
}

.link {
  color: #E8A8BF;
  font-weight: 500;
}

/* ===== 加载状态 ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,12,41,0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  z-index: 9999;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
}

.spinner-ring {
  width: 100%;
  height: 100%;
  border: 6rpx solid rgba(157,212,184,0.15);
  border-top-color: #E8A8BF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: rgba(106,96,104,1.0);
}
<!-- 设置页面 -->
<view class="page settings-page">
  <view class="settings-content">

    <!-- 数据 -->
    <view class="settings-section">
      <text class="section-label">数据管理</text>
      <view class="settings-card">
        <!-- 清除缓存 -->
        <view class="settings-item clickable" bindtap="handleClearCache">
          <view class="item-left">
            <text class="item-label">清除缓存</text>
            <text class="item-desc">清除本地临时数据，不影响你的测试记录</text>
          </view>
          <text class="item-value">{{cacheSize}}</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="settings-section">
      <text class="section-label">关于</text>
      <view class="settings-card">
        <!-- 版本信息 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">当前版本</text>
          </view>
          <text class="item-value">{{appVersion}}</text>
        </view>

        <!-- 检查更新 -->
        <view class="settings-item clickable" bindtap="handleCheckUpdate">
          <view class="item-left">
            <text class="item-label">检查更新</text>
            <text class="item-desc">检查是否有新版本</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 隐私说明 -->
        <view class="settings-item clickable" bindtap="handleOpenPrivacyPolicy">
          <view class="item-left">
            <text class="item-label">隐私说明</text>
            <text class="item-desc">查看隐私保护指引</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 使用说明 -->
        <view class="settings-item clickable" bindtap="handleOpenTerms">
          <view class="item-left">
            <text class="item-label">使用说明</text>
            <text class="item-desc">了解小程序功能与使用方法</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 意见反馈 -->
        <view class="settings-item clickable" bindtap="handleFeedback">
          <view class="item-left">
            <text class="item-label">意见反馈</text>
            <text class="item-desc">反馈问题或建议</text>
          </view>
          <view class="item-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="button-area">
      <button class="btn btn-danger" bindtap="handleLogout">退出登录</button>
      <text class="logout-hint">退出后重新进入将自动登录</text>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="spinner">
      <view class="spinner-ring"></view>
    </view>
  </view>

  <!-- 消息提示 -->
  <view wx:if="{{message.show}}" class="message" style="background-color: {{message.type === 'success' ? '#7CC4A0' : '#E08A9A'}}">
    {{message.text}}
  </view>
</view>

<!-- 用户偏好设置页面 -->
<view class="page settings-page">
  <!-- 页面内容 -->
  <view class="settings-content">
    <!-- 应用设置 -->
    <view class="settings-section">
      <text class="section-label">应用设置</text>
      <view class="settings-card">
        <!-- 主题设置 -->
        <picker 
          range="{{themeOptions}}"
          range-key="text"
          value="{{themeIndex}}"
          bindchange="onThemeChange"
        >
          <view class="settings-item">
            <view class="item-left">
              <text class="item-label">主题</text>
              <text class="item-desc">选择应用主题</text>
            </view>
            <view class="item-right">
              <text class="picker-value">{{themeOptions[themeIndex].text}}</text>
              <view class="item-arrow"></view>
            </view>
          </view>
        </picker>

        <!-- 字号设置 -->
        <picker 
          range="{{fontSizeOptions}}"
          range-key="text"
          value="{{fontSizeIndex}}"
          bindchange="onFontSizeChange"
        >
          <view class="settings-item">
            <view class="item-left">
              <text class="item-label">字号</text>
              <text class="item-desc">调整应用文字大小</text>
            </view>
            <view class="item-right">
              <text class="picker-value">{{fontSizeOptions[fontSizeIndex].text}}</text>
              <view class="item-arrow"></view>
            </view>
          </view>
        </picker>

        <!-- 语言设置 -->
        <picker 
          range="{{languageOptions}}"
          range-key="text"
          value="{{languageIndex}}"
          bindchange="onLanguageChange"
        >
          <view class="settings-item">
            <view class="item-left">
              <text class="item-label">语言</text>
              <text class="item-desc">选择应用语言</text>
            </view>
            <view class="item-right">
              <text class="picker-value">{{languageOptions[languageIndex].text}}</text>
              <view class="item-arrow"></view>
            </view>
          </view>
        </picker>
      </view>
    </view>

    <!-- 提醒设置 -->
    <view class="settings-section">
      <text class="section-label">提醒设置</text>
      <view class="settings-card">
        <!-- 内容提醒 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">内容提醒</text>
            <text class="item-desc">接收内容更新提醒</text>
          </view>
          <switch 
            checked="{{preferences.notificationType.message}}"
            bindchange="onNotificationTypeChange"
            data-type="message"
            color="#DC8DA8"
          />
        </view>

        <!-- 补充提醒 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">补充提醒</text>
            <text class="item-desc">接收补充内容提醒</text>
          </view>
          <switch 
            checked="{{preferences.notificationType.comment}}"
            bindchange="onNotificationTypeChange"
            data-type="comment"
            color="#DC8DA8"
          />
        </view>

        <!-- 标记提醒 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">标记提醒</text>
            <text class="item-desc">接收标记变化提醒</text>
          </view>
          <switch 
            checked="{{preferences.notificationType.like}}"
            bindchange="onNotificationTypeChange"
            data-type="like"
            color="#DC8DA8"
          />
        </view>

        <!-- 记录提醒 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">记录提醒</text>
            <text class="item-desc">接收记录状态提醒</text>
          </view>
          <switch 
            checked="{{preferences.notificationType.follow}}"
            bindchange="onNotificationTypeChange"
            data-type="follow"
            color="#DC8DA8"
          />
        </view>

        <!-- 功能提醒 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">功能提醒</text>
            <text class="item-desc">接收功能更新提醒</text>
          </view>
          <switch 
            checked="{{preferences.notificationType.system}}"
            bindchange="onNotificationTypeChange"
            data-type="system"
            color="#DC8DA8"
          />
        </view>
      </view>
    </view>

    <!-- 显示设置 -->
    <view class="settings-section">
      <text class="section-label">显示设置</text>
      <view class="settings-card">
        <!-- 资料显示 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">资料仅自己可见</text>
            <text class="item-desc">仅在当前设备内查看资料内容</text>
          </view>
          <switch 
            checked="{{preferences.privateProfile}}"
            bindchange="onPrivacyChange"
            data-setting="privateProfile"
            color="#DC8DA8"
          />
        </view>

        <!-- 内容搜索 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">搜索记录</text>
            <text class="item-desc">允许在本地记录中进行搜索</text>
          </view>
          <switch 
            checked="{{preferences.allowSearch}}"
            bindchange="onPrivacyChange"
            data-setting="allowSearch"
            color="#DC8DA8"
          />
        </view>

        <!-- 内容展示 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">内容展示</text>
            <text class="item-desc">控制记录内容的显示方式</text>
          </view>
          <switch 
            checked="{{preferences.allowRecommend}}"
            bindchange="onPrivacyChange"
            data-setting="allowRecommend"
            color="#DC8DA8"
          />
        </view>
      </view>
    </view>

    <!-- 媒体设置 -->
    <view class="settings-section">
      <text class="section-label">媒体设置</text>
      <view class="settings-card">
        <!-- 自动播放视频 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">自动播放视频</text>
            <text class="item-desc">在列表中自动播放视频</text>
          </view>
          <switch 
            checked="{{preferences.autoPlayVideo}}"
            bindchange="onMediaChange"
            data-setting="autoPlayVideo"
            color="#DC8DA8"
          />
        </view>
      </view>
    </view>

    <!-- 数据 -->
    <view class="settings-section">
      <text class="section-label">数据</text>
      <view class="settings-card">
        <!-- 数据分析 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">数据分析</text>
            <text class="item-desc">帮助改进使用体验</text>
          </view>
          <switch 
            checked="{{preferences.dataConsent}}"
            bindchange="onDataChange"
            data-setting="dataConsent"
            color="#DC8DA8"
          />
        </view>

        <!-- 清除缓存 -->
        <view class="settings-item clickable" bindtap="handleClearCache">
          <view class="item-left">
            <text class="item-label">清除缓存</text>
            <text class="item-desc">清除应用临时数据</text>
          </view>
          <text class="item-value">{{cacheSize}}</text>
        </view>

        <!-- 整理数据 -->
        <view class="settings-item clickable" bindtap="handleExportData">
          <view class="item-left">
            <text class="item-label">整理数据</text>
            <text class="item-desc">整理当前设备内的数据内容</text>
          </view>
          <view class="item-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="settings-section">
      <text class="section-label">关于</text>
      <view class="settings-card">
        <!-- 版本信息 -->
        <view class="settings-item">
          <view class="item-left">
            <text class="item-label">版本</text>
            <text class="item-desc">当前应用版本</text>
          </view>
          <text class="item-value">{{appVersion}}</text>
        </view>

        <!-- 检查更新 -->
        <view class="settings-item clickable" bindtap="handleCheckUpdate">
          <view class="item-left">
            <text class="item-label">检查更新</text>
            <text class="item-desc">检查是否有新版本</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 隐私说明 -->
        <view class="settings-item clickable" bindtap="handleOpenPrivacyPolicy">
          <view class="item-left">
            <text class="item-label">隐私说明</text>
            <text class="item-desc">查看隐私说明</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 使用说明 -->
        <view class="settings-item clickable" bindtap="handleOpenTerms">
          <view class="item-left">
            <text class="item-label">使用说明</text>
            <text class="item-desc">查看使用说明</text>
          </view>
          <view class="item-arrow"></view>
        </view>

        <!-- 应用说明 -->
        <view class="settings-item clickable" bindtap="handleOpenAbout">
          <view class="item-left">
            <text class="item-label">应用说明</text>
            <text class="item-desc">了解本小程序的功能说明</text>
          </view>
          <view class="item-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="button-area">
      <button class="btn btn-danger" bindtap="handleLogout">登出</button>
      <text class="logout-hint">退出后可重新进入</text>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="spinner">
      <view class="spinner-ring"></view>
    </view>
  </view>

  <!-- 消息提示 -->
  <view wx:if="{{message.show}}" class="message" style="background-color: {{message.type === 'success' ? '#4ADE80' : '#EF4444'}}">
    {{message.text}}
  </view>
</view>
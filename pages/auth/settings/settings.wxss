/* 设置页 - 梦幻渐变主题 */

.settings-page {
  min-height: 100vh;
  background: var(--gradient-bg);
  background-attachment: fixed;
}

.settings-content {
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 分段（标签 + 卡片） ===== */

.settings-section {
  margin-bottom: 40rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* ===== 卡片容器 ===== */

.settings-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  overflow: hidden;
  backdrop-filter: blur(10px);
}

/* ===== 设置项 ===== */

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item.clickable:active {
  background: var(--bg-card-hover);
}

/* ===== 项左侧 ===== */

.item-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
  margin-right: 24rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
}

.item-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

/* ===== 项右侧（值+箭头） ===== */

.item-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.picker-value {
  font-size: 24rpx;
  color: var(--text-tertiary);
  white-space: nowrap;
  line-height: 1.4;
}

/* ===== Switch 美化 ===== */

switch {
  transform: scale(0.85);
  flex-shrink: 0;
}

/* ===== 右侧箭头 & 值 ===== */

.item-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.item-value {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ===== 底部按钮区 ===== */

.button-area {
  padding: 48rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-danger {
  width: 100%;
  height: 88rpx;
  background: transparent !important;
  border: 2rpx solid var(--danger-color) !important;
  border-radius: var(--radius-xl) !important;
  color: var(--danger-color) !important;
  font-size: 28rpx !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.btn-danger::after {
  border: none;
}

.btn-danger:active {
  background: rgba(248, 113, 113, 0.1) !important;
}

.logout-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* ===== 加载遮罩 ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-mask);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  position: relative;
}

.spinner-ring {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 消息提示 ===== */

.message {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  font-weight: 500;
  color: #5A4A5A;
  backdrop-filter: blur(20px);
  z-index: 1000;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    transform: translateX(-50%) translateY(-40rpx);
    opacity: 0;
  }
  to {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
}
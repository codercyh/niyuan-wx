/* 设置页 - 深色渐变主题 */

.settings-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--gradient-bg);
  background-attachment: fixed;
}

/* ===== 顶部导航 ===== */

.settings-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: rgba(15, 12, 41, 0.8);
  backdrop-filter: blur(20px);
  position: sticky;
  top: 0;
  z-index: 100;
}

.btn-back {
  font-size: 32rpx;
  color: var(--text-secondary);
  background: none;
  border: none;
  padding: 12rpx 8rpx 12rpx 0;
  margin: 0;
  line-height: 1;
}

.btn-back::after {
  border: none;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-left: 16rpx;
}

/* ===== 滚动内容区 ===== */

.settings-content {
  flex: 1;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ===== 分组 ===== */

.settings-group {
  margin: 0 32rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-color);
  overflow: hidden;
}

.group-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  padding: 24rpx 32rpx 0;
}

.group-title-with-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 8rpx;
}

.group-title-with-toggle .group-title {
  padding: 0;
}

/* ===== 设置项 ===== */

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: background 0.2s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item.clickable:active {
  background: var(--bg-card-hover);
}

.item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.item-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ===== 选择器 ===== */

.picker-small {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.picker-value {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 8rpx 20rpx;
  background: var(--primary-bg);
  border-radius: var(--radius-full);
  border: 1px solid rgba(255, 107, 53, 0.3);
}

/* ===== Toggle Switch 美化 ===== */

.toggle-switch {
  transform: scale(0.8);
  flex-shrink: 0;
}

/* ===== 箭头 & 值 ===== */

.arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.cache-size {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.version {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ===== 底部按钮区 ===== */

.button-area {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-danger {
  width: 100%;
  height: 88rpx;
  background: transparent !important;
  border: 2rpx solid var(--danger-color) !important;
  border-radius: var(--radius-xl) !important;
  color: var(--danger-color) !important;
  font-size: 28rpx !important;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
}

.btn-danger::after {
  border: none;
}

.btn-danger:active {
  background: rgba(248, 113, 113, 0.1) !important;
}

.logout-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
}

/* ===== 加载遮罩 ===== */

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-mask);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  position: relative;
}

.spinner-ring {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 消息提示 ===== */

.message {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 24rpx);
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
  backdrop-filter: blur(20px);
  z-index: 1000;
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    transform: translateX(-50%) translateY(-40rpx);
    opacity: 0;
  }
  to {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
}
<!-- 用户信息编辑页面 -->
<view class="page profile-edit-page">
  <!-- 顶部导航 -->
  <view class="edit-header">
    <text class="header-title">编辑个人信息</text>
    <button class="btn-save" bindtap="handleSave" loading="{{saving}}">
      保存
    </button>
  </view>

  <!-- 头像编辑 -->
  <view class="section avatar-section">
    <text class="section-title">头像</text>
    
    <view class="avatar-wrapper">
      <image 
        class="avatar-image" 
        src="{{avatarUrl || '/images/default-avatar.png'}}"
        mode="aspectFill"
      />
      <view class="avatar-overlay">
        <button class="btn-change-avatar" bindtap="handleChooseAvatar">
          <text class="btn-icon">📷</text>
          更换头像
        </button>
      </view>
    </view>

    <!-- 头像上传进度 -->
    <view wx:if="{{avatarUploading}}" class="upload-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{avatarProgress}}%"></view>
      </view>
      <text class="progress-text">上传中... {{avatarProgress}}%</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section basic-info-section">
    <text class="section-title">基本信息</text>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="label">昵称</text>
      <input 
        class="input-field" 
        type="text"
        placeholder="请输入昵称"
        maxlength="20"
        bindinput="onNicknameChange"
        value="{{formData.nickName}}"
      />
      <text class="char-count">{{formData.nickName.length}}/20</text>
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="label">性别</text>
      <picker 
        class="picker-field"
        range="{{genderOptions}}"
        range-key="text"
        value="{{genderIndex}}"
        bindchange="onGenderChange"
      >
        <text class="picker-text">{{genderOptions[genderIndex].text}}</text>
        <text class="picker-icon">›</text>
      </picker>
    </view>

    <!-- 出生日期 -->
    <view class="form-item">
      <text class="label">出生日期</text>
      <picker 
        class="picker-field"
        mode="date"
        value="{{formData.birthDate}}"
        start="1900-01-01"
        end="{{today}}"
        bindchange="onBirthDateChange"
      >
        <text class="picker-text">{{formData.birthDate || '选择日期'}}</text>
        <text class="picker-icon">›</text>
      </picker>
    </view>
  </view>

  <!-- 位置信息 -->
  <view class="section location-section">
    <text class="section-title">位置信息</text>

    <!-- 省份 -->
    <view class="form-item">
      <text class="label">省份</text>
      <picker 
        class="picker-field"
        range="{{provinces}}"
        value="{{provinceIndex}}"
        bindchange="onProvinceChange"
      >
        <text class="picker-text">{{provinces[provinceIndex] || '选择省份'}}</text>
        <text class="picker-icon">›</text>
      </picker>
    </view>

    <!-- 城市 -->
    <view class="form-item">
      <text class="label">城市</text>
      <picker 
        class="picker-field"
        range="{{cities}}"
        value="{{cityIndex}}"
        bindchange="onCityChange"
        disabled="{{cities.length === 0}}"
      >
        <text class="picker-text {{cities.length === 0 ? 'disabled' : ''}}">
          {{cities[cityIndex] || '先选择省份'}}
        </text>
        <text class="picker-icon">›</text>
      </picker>
    </view>
  </view>

  <!-- 个人简介 -->
  <view class="section bio-section">
    <text class="section-title">个人简介</text>
    
    <textarea 
      class="bio-textarea"
      placeholder="输入您的个人简介（可选）"
      maxlength="200"
      bindinput="onBioChange"
      value="{{formData.bio}}"
    />
    <text class="char-count">{{formData.bio.length}}/200</text>
  </view>

  <!-- 保存按钮 -->
  <view class="button-group">
    <button class="btn btn-primary btn-large" bindtap="handleSave" loading="{{saving}}">
      {{saving ? '保存中...' : '保存更改'}}
    </button>
    
    <button class="btn btn-text" bindtap="handleCancel">
      取消
    </button>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-overlay">
    <view class="spinner">
      <view class="spinner-ring"></view>
    </view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 消息提示 -->
  <view wx:if="{{message.show}}" class="message" style="background-color: {{message.type === 'success' ? '#4ADE80' : '#EF4444'}}">
    {{message.text}}
  </view>
</view>

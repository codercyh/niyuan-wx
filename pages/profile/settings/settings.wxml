<!-- 设置页面 -->
<scroll-view scroll-y class="page-scroll">
  <!-- 使用提醒 -->
  <view class="section">
    <view class="section-title">🔔 使用提醒</view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">内容提醒</text>
        <text class="label-sub">接收记录变化提示</text>
      </view>
      <view class="toggle {{notifyComments ? 'active' : ''}}" bindtap="onToggleNotify" data-type="comments">
        <view class="toggle-circle"></view>
      </view>
    </view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">功能提醒</text>
        <text class="label-sub">接收功能更新提示</text>
      </view>
      <view class="toggle {{notifySystem ? 'active' : ''}}" bindtap="onToggleNotify" data-type="system">
        <view class="toggle-circle"></view>
      </view>
    </view>
  </view>

  <!-- 显示设置 -->
  <view class="section">
    <view class="section-title">🔒 显示</view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">资料显示</text>
        <text class="label-sub">{{profileVisible}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">记录显示</text>
        <text class="label-sub">{{activityVisible}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 显示设置 -->
  <view class="section">
    <view class="section-title">🎨 显示</view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">主题</text>
        <text class="label-sub">浅色（当前风格）</text>
      </view>
      <text class="value-text">已启用</text>
    </view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">字体大小</text>
        <text class="label-sub">中等</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="section-title">💾 数据</view>
    <view class="setting-item" bindtap="onClearCache">
      <view class="setting-label">
        <text class="label-main">清除缓存</text>
        <text class="label-sub">释放存储空间</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onExportData">
      <view class="setting-label">
        <text class="label-main">整理记录</text>
        <text class="label-sub">整理测试与记录内容</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="section">
    <view class="section-title">ℹ️ 关于</view>
    <view class="setting-item">
      <view class="setting-label">
        <text class="label-main">应用版本</text>
      </view>
      <text class="value-text">v1.5</text>
    </view>
    <view class="setting-item" bindtap="onUserAgreement">
      <view class="setting-label">
        <text class="label-main">隐私说明</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onFeedback">
      <view class="setting-label">
        <text class="label-main">使用说明</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="bottom-space"></view>
</scroll-view>

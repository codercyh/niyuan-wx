<!-- 个人页面 -->
<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar-section" wx:if="{{!isLoggedIn}}">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{tempAvatarUrl || '/assets/icons/me-active.png'}}" mode="aspectFill"></image>
      </button>
      <view class="user-info user-info-login">
        <view class="nickname-input-wrap">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="请输入微信昵称"
            maxlength="20"
            bindinput="onInputNickname"
            value="{{tempNickName}}"
          />
        </view>
        <text class="join-date">选择微信头像和昵称后将自动完成登录</text>
      </view>
    </view>
    <view class="avatar-section" wx:else>
      <view class="avatar-static">
        <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/me-active.png'}}" mode="aspectFill"></image>
      </view>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName || '用户'}}</text>
        <text class="join-date">已使用 {{daysJoined}} 天</text>
      </view>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{testCount}}</text>
        <text class="stat-label">心理测试</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{fateCount}}</text>
        <text class="stat-label">互动报告</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{avgScore}}</text>
        <text class="stat-label">平均得分</text>
      </view>
    </view>
  </view>

  <!-- 互动报告历史 -->
  <view class="section" wx:if="{{fateHistory.length > 0}}">
    <view class="section-header">
      <text class="section-title">💕 最近互动报告</text>
      <view class="section-more" bindtap="onGoToHistory">
        <text>查看全部</text>
        <view class="more-arrow"></view>
      </view>
    </view>
    <view class="fate-history-list">
      <view class="fate-history-item" wx:for="{{fateHistory}}" wx:key="id" bindtap="onViewFateResult" data-id="{{item.id}}">
        <view class="fate-names-row">
          <text class="fate-pair">{{item.nameA}} × {{item.nameB}}</text>
          <text class="fate-level {{item.levelClass}}">{{item.level}}级</text>
        </view>
        <view class="fate-score-row">
          <text class="fate-big-score">{{item.score}}</text>
          <text class="fate-type-name">{{item.fateType}}</text>
        </view>
        <text class="fate-time">{{item.date}}</text>
      </view>
    </view>
  </view>

  <!-- 心理测试历史 -->
  <view class="section" wx:if="{{testHistory.length > 0}}">
    <view class="section-header">
      <text class="section-title">🧪 最近心理测试</text>
      <view class="section-more" bindtap="onGoToHistory">
        <text>查看全部</text>
        <view class="more-arrow"></view>
      </view>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{testHistory}}" wx:key="id" bindtap="onViewTestResult" data-id="{{item.id}}">
        <text class="history-emoji">{{item.emoji}}</text>
        <view class="history-info">
          <text class="history-name">{{item.name}}</text>
          <text class="history-date">{{item.date}}</text>
        </view>
        <text class="history-score">{{item.score}}分</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onGoToHistory">
      <text class="menu-icon">📋</text>
      <text class="menu-text">全部记录</text>
      <view class="menu-arrow"></view>
    </view>
    <view class="menu-item" bindtap="onGoToFate">
      <text class="menu-icon">💕</text>
      <text class="menu-text">互动报告</text>
      <view class="menu-arrow"></view>
    </view>
    <view class="menu-item" bindtap="onGoToSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <view class="menu-arrow"></view>
    </view>
    <view class="menu-item" bindtap="onFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <view class="menu-arrow"></view>
    </view>
  </view>

  <!-- 退出使用 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="onLogout">退出使用</button>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-space"></view>
</view>

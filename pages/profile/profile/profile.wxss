/* 个人页面样式 - 梦幻渐变主题 */
.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #FAEEFF 40%, #F3E8FF 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(
    135deg,
    rgba(255,123,169, 0.2) 0%,
    rgba(155,107,255, 0.15) 100%
  );
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  border: 1px solid rgba(255,123,169, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(255,123,169, 0.2);
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

/* 头像容器（登录/未登录共用） */
.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  min-height: 128rpx;
  padding: 0 !important;
  margin: 0 12rpx 0 0;
  background: transparent !important;
  border: none !important;
  line-height: 128rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: visible;
  font-size: 0;
  color: transparent;
  display: block;
}

.avatar-btn::after {
  border: none !important;
  display: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,123,169, 0.5);
  box-shadow: 0 0 20rpx rgba(255,123,169, 0.3);
  box-sizing: border-box;
  display: block;
  vertical-align: top;
}

/* 昵称输入框 */
.nickname-input-wrap {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 0;
  border-bottom: 2rpx solid rgba(155,107,255,0.15);
  box-sizing: border-box;
}

.nickname-input {
  width: 100%;
  height: 72rpx;
  min-height: 72rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #5A4A5A;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 72rpx;
  box-sizing: border-box;
}

.nickname-input::placeholder {
  color: rgba(90,74,90,1.0);
}

.nickname-input:focus {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.nickname-input-wrap:focus-within {
  border-bottom-color: rgba(255,123,169, 0.55);
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 0;
  padding-left: 0;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #5A4A5A;
  margin-bottom: 8rpx;
}

.join-date {
  font-size: 24rpx;
  color: rgba(90,74,90,1.0);
}

.avatar-static {
  width: 128rpx;
  height: 128rpx;
  margin: 0 12rpx 0 0;
  flex-shrink: 0;
  display: block;
}

.user-info-login {
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 0;
  padding-left: 0;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  background: rgba(255,255,255,0.6);
  border-radius: 24rpx;
  padding: 32rpx 0;
  border: 1px solid rgba(155,107,255,0.15);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #5A4A5A;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(90,74,90,1.0);
}

/* 区块 */
.section {
  background: rgba(155,107,255,0.04);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1px solid rgba(155,107,255,0.15);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A4A5A;
}

.section-more {
  font-size: 24rpx;
  color: #FF7BA9;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(155,107,255,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(155,107,255,0.15);
}

.history-emoji {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.history-info {
  flex: 1;
}

.history-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #5A4A5A;
}

.history-date {
  font-size: 24rpx;
  color: rgba(90,74,90,1.0);
}

.history-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF7BA9;
}

/* 菜单 */
.menu-section {
  background: rgba(155,107,255,0.04);
  border-radius: 32rpx;
  overflow: hidden;
  border: 1px solid rgba(155,107,255,0.15);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(155,107,255,0.15);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #5A4A5A;
}

.menu-arrow {
  font-size: 28rpx;
  color: rgba(90,74,90,1.0);
}

/* 退出使用 */
.logout-section {
  margin-top: 48rpx;
  padding: 0 32rpx;
}

.logout-btn {
  width: 100%;
  background: rgba(255, 77, 79, 0.1) !important;
  border: 2rpx solid #ff4d4f !important;
  border-radius: 24rpx;
  padding: 28rpx;
  color: #ff4d4f;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  line-height: 1.4;
}

.logout-btn::after {
  border: none;
}

.logout-btn text {
  color: #ff4d4f;
  font-size: 30rpx;
}

/* 底部间距 */
.bottom-space {
  height: 80rpx;
}

/* 缘分测试历史列表 */
.fate-history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fate-history-item {
  background: linear-gradient(
    135deg,
    rgba(255,123,169, 0.1) 0%,
    rgba(155,107,255, 0.08) 100%
  );
  border: 1px solid rgba(255,123,169, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
}

.fate-names-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.fate-pair {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4A5A;
}

.fate-level {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.fate-level.level-s {
  background: linear-gradient(135deg, #FFC85C 0%, #FF7BA9 100%);
  color: #FFFFFF;
}

.fate-level.level-a {
  background: linear-gradient(135deg, #00d9ff 0%, #0066ff 100%);
  color: #FFFFFF;
}

.fate-level.level-b {
  background: linear-gradient(135deg, #00ff87 0%, #00d9ff 100%);
  color: #333333;
}

.fate-level.level-c {
  background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
  color: #FFFFFF;
}

.fate-level.level-d {
  background: #6366f1;
  color: #5A4A5A;
}

.fate-score-row {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.fate-big-score {
  font-size: 56rpx;
  font-weight: 800;
  color: #FF7BA9;
}

.fate-type-name {
  font-size: 26rpx;
  color: rgba(90,74,90,1.0);
}

.fate-time {
  font-size: 22rpx;
  color: rgba(90,74,90,1.0);
}

/* 个人页面样式 - 深色渐变主题 */
.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

/* 用户卡片 */
.user-card {
  background: linear-gradient(135deg, rgba(255,107,53,0.2) 0%, rgba(255,0,110,0.15) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  border: 1px solid rgba(255,107,53,0.2);
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.2);
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,107,53,0.5);
  margin-right: 32rpx;
  box-shadow: 0 0 20rpx rgba(255,107,53,0.3);
}

/* 登录按钮（头像选择） */
.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0 32rpx 0 0;
  background: transparent;
  border: none;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

/* 昵称输入框 */
.nickname-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: transparent;
  border: none;
  padding: 0;
  margin-bottom: 8rpx;
  width: 100%;
}

.nickname-input::placeholder {
  color: rgba(255,255,255,0.5);
}

.user-info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.join-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  background: rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 32rpx 0;
  border: 1px solid rgba(255,255,255,0.1);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 区块 */
.section {
  background: rgba(255,255,255,0.05);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1px solid rgba(255,255,255,0.1);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.section-more {
  font-size: 24rpx;
  color: #FF6B35;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  border: 1px solid rgba(255,255,255,0.08);
}

.history-emoji {
  font-size: 48rpx;
  margin-right: 24rpx;
}

.history-info {
  flex: 1;
}

.history-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.history-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.history-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
}

/* 菜单 */
.menu-section {
  background: rgba(255,255,255,0.05);
  border-radius: 32rpx;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #FFFFFF;
}

.menu-arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
}

/* 退出使用 */
.logout-section {
  margin-top: 48rpx;
  padding: 0 32rpx;
}

.logout-btn {
  width: 100%;
  background: rgba(255,77,79,0.1) !important;
  border: 2rpx solid #ff4d4f !important;
  border-radius: 24rpx;
  padding: 28rpx;
  color: #ff4d4f;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  line-height: 1.4;
}

.logout-btn::after {
  border: none;
}

.logout-btn text {
  color: #ff4d4f;
  font-size: 30rpx;
}

/* 底部间距 */
.bottom-space {
  height: 80rpx;
}

/* 缘分测试历史列表 */
.fate-history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.fate-history-item {
  background: linear-gradient(135deg, rgba(255,107,53,0.1) 0%, rgba(255,0,110,0.08) 100%);
  border: 1px solid rgba(255,107,53,0.2);
  border-radius: 24rpx;
  padding: 24rpx;
}

.fate-names-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.fate-pair {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.fate-level {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.fate-level.level-s {
  background: linear-gradient(135deg, #FFD700 0%, #FF6B35 100%);
  color: #FFFFFF;
}

.fate-level.level-a {
  background: linear-gradient(135deg, #00D9FF 0%, #0066FF 100%);
  color: #FFFFFF;
}

.fate-level.level-b {
  background: linear-gradient(135deg, #00FF87 0%, #00D9FF 100%);
  color: #333333;
}

.fate-level.level-c {
  background: linear-gradient(135deg, #A855F7 0%, #6366F1 100%);
  color: #FFFFFF;
}

.fate-level.level-d {
  background: #6366F1;
  color: #FFFFFF;
}

.fate-score-row {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.fate-big-score {
  font-size: 56rpx;
  font-weight: 800;
  color: #FF6B35;
}

.fate-type-name {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

.fate-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

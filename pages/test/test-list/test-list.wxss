/* 测试列表页 - 梦幻渐变主题 */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF6F6 0%, #FFF8F0 40%, #F0F8F4 100%);
}

/* 顶部搜索栏 */
.search-container {
  padding: 24rpx 32rpx;
  background: rgba(157,212,184,0.04);
  border-bottom: 1px solid rgba(157,212,184,0.15);
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.6);
  border-radius: 48rpx;
  padding: 20rpx 28rpx;
  gap: 16rpx;
  border: 1px solid rgba(157,212,184,0.15);
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
  color: #6A6068;
}

.search-input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 28rpx;
  color: #6A6068;
  line-height: normal;
}

.search-input::placeholder {
  color: rgba(106,96,104,1.0);
}

.clear-btn {
  font-size: 32rpx;
  color: rgba(106,96,104,1.0);
  padding: 8rpx;
}

/* 分类Tab */
.category-scroll {
  white-space: nowrap;
  background: rgba(157,212,184,0.04);
  border-bottom: 1px solid rgba(157,212,184,0.15);
}

.category-list {
  display: inline-flex;
  padding: 24rpx 32rpx;
  gap: 20rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 48rpx;
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
  border: 1px solid rgba(157,212,184,0.15);
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #E8A8BF 0%, #9DD4B8 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(232,168,191,0.3);
}

.category-emoji {
  font-size: 28rpx;
}

.category-name {
  white-space: nowrap;
}

/* 测试列表容器 */
.test-list-container {
  flex: 1;
  height: calc(100vh - 240rpx);
}

/* 排序选项 */
.sort-container {
  display: flex;
  padding: 24rpx 32rpx;
  gap: 32rpx;
  background: rgba(157,212,184,0.04);
  border-bottom: 1px solid rgba(157,212,184,0.15);
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.sort-item.active {
  color: #E8A8BF;
  background: rgba(232,168,191,0.15);
  font-weight: 600;
}

.sort-icon {
  font-size: 28rpx;
}

/* 测试卡片列表 */
.test-cards {
  padding: 32rpx;
}

.test-card {
  padding: 32rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(157,212,184,0.15);
  transition: all 0.3s ease;
}

.test-card:active {
  background: rgba(255,255,255,0.6);
  border-color: rgba(232,168,191,0.3);
  transform: translateY(-4rpx);
}

.test-card-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.test-emoji {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, rgba(232,168,191,0.3) 0%, rgba(157,212,184,0.2) 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
  border: 1px solid rgba(232,168,191,0.2);
}

.test-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.test-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #6A6068;
}

.test-category {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

.test-stats {
  text-align: right;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #E8A8BF;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(106,96,104,1.0);
}

.test-description {
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
  line-height: 1.5;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.test-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1px solid rgba(157,212,184,0.15);
}

.test-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background: rgba(232,168,191,0.15);
  color: #E8A8BF;
  border-radius: 24rpx;
  border: 1px solid rgba(232,168,191,0.2);
}

.test-action {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.star {
  font-size: 28rpx;
}

.rating-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #FFD93D;
}

.arrow {
  font-size: 36rpx;
  color: rgba(106,96,104,1.0);
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
}

/* 没有更多 */
.no-more {
  padding: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 24rpx;
}

.empty-icon {
  font-size: 96rpx;
}

.empty-text {
  font-size: 28rpx;
  color: rgba(106,96,104,1.0);
}

.empty-hint {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

/* 底部占位 */
.bottom-space {
  height: 200rpx;
}

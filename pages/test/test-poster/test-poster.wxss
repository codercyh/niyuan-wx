/* 测试海报页面样式 */
.poster-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FCEEEE 0%, #FFF0E8 40%, #E8F5EE 100%);
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* 预览区域 */
.preview-section {
  margin-bottom: 32rpx;
}

.preview-card {
  width: 100%;
  min-height: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

/* 搞怪风 */
.poster-funny {
  width: 100%;
  min-height: 600rpx;
  background: linear-gradient(180deg, #FCEEEE 0%, #FFF0E8 40%, #E8F5EE 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.stars-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.star {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.8);
  border-radius: 50%;
}

.star:nth-child(1) { top: 8%; left: 10%; }
.star:nth-child(2) { top: 12%; left: 85%; }
.star:nth-child(3) { top: 22%; left: 75%; }
.star:nth-child(4) { top: 32%; left: 20%; }
.star:nth-child(5) { top: 45%; left: 90%; }
.star:nth-child(6) { top: 58%; left: 15%; }
.star:nth-child(7) { top: 68%; left: 80%; }
.star:nth-child(8) { top: 78%; left: 30%; }

.poster-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.big-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #5A4F56;
  margin-bottom: 16rpx;
}

.fate-level {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  margin-bottom: 20rpx;
}

.score-big {
  font-size: 144rpx;
  font-weight: bold;
  color: #DC8DA8;
  line-height: 1.2;
  text-shadow: 0 0 40rpx rgba(220,141,168,0.5);
}

.test-name {
  font-size: 26rpx;
  color: rgba(90,79,86,1.0);
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.description {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  max-width: 600rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.traits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
  justify-content: center;
}

.traits text {
  font-size: 22rpx;
  color: #00D9FF;
  background: rgba(0, 217, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(0, 217, 255, 0.3);
}

/* 文艺风 */
.poster-artistic {
  width: 100%;
  min-height: 600rpx;
  background: linear-gradient(180deg, #E8F5EE 0%, #16213e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.artistic-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.artistic-header text {
  font-size: 28rpx;
  color: rgba(90,79,86,1.0);
  line-height: 1.8;
}

.divider-line {
  width: 160rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.8);
  margin: 32rpx 0;
}

.poster-artistic .result-title {
  font-size: 40rpx;
  margin-bottom: 16rpx;
}

.test-name-artistic {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  margin-bottom: 40rpx;
}

.score-artistic {
  font-size: 120rpx;
  font-weight: bold;
  color: #00D9FF;
  line-height: 1.2;
  text-shadow: 0 0 40rpx rgba(0, 217, 255, 0.5);
}

.poster-artistic .description {
  color: rgba(90,79,86,1.0);
  margin-top: 40rpx;
}

/* 极简风 */
.poster-minimal {
  width: 100%;
  min-height: 600rpx;
  background: #0a0a0a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.test-name-minimal {
  font-size: 28rpx;
  color: rgba(90,79,86,1.0);
  margin-bottom: 32rpx;
}

.result-title-minimal {
  font-size: 40rpx;
  font-weight: bold;
  color: #5A4F56;
  margin-bottom: 40rpx;
}

.score-minimal {
  font-size: 180rpx;
  font-weight: bold;
  color: #DC8DA8;
  line-height: 1;
  text-shadow: 0 0 60rpx rgba(220,141,168,0.5);
}

.description-minimal {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  margin-top: 32rpx;
  max-width: 600rpx;
  text-align: center;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 表情包风 */
.poster-meme {
  width: 100%;
  min-height: 600rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.meme-emoji {
  font-size: 200rpx;
  margin-bottom: 20rpx;
}

.result-title-meme {
  font-size: 36rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 24rpx;
}

.score-meme {
  font-size: 64rpx;
  font-weight: bold;
  color: #DC8DA8;
  margin-bottom: 24rpx;
}

.test-name-meme {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.description-meme {
  font-size: 24rpx;
  color: #999999;
  max-width: 600rpx;
  text-align: center;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 风格选择 */
.style-section {
  margin-bottom: 32rpx;
}

.style-title {
  font-size: 28rpx;
  color: rgba(90,79,86,1.0);
  margin-bottom: 20rpx;
  text-align: center;
}

.style-list {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.style-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 16rpx;
  border: 2rpx solid rgba(124,196,160,0.32);
  transition: all 0.3s;
}

.style-item.style-selected {
  background: rgba(220,141,168,0.2);
  border-color: #DC8DA8;
}

.style-emoji {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.style-name {
  font-size: 22rpx;
  color: rgba(90,79,86,1.0);
}

.style-selected .style-name {
  color: #DC8DA8;
}

/* 操作按钮 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(180deg, transparent 0%, #FCEEEE 30%);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #DC8DA8 0%, #7CC4A0 100%) !important;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-save::after {
  border: none;
}

.btn-save text {
  color: #5A4F56;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-save[disabled] {
  opacity: 0.5;
}

.btn-share {
  width: 100%;
  height: 88rpx;
  background: rgba(255,255,255,0.8) !important;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #5A4F56 !important;
  border: 1rpx solid rgba(124,196,160,0.32) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-share::after {
  border: none;
}

.btn-share text {
  color: #5A4F56;
  font-size: 30rpx;
}

.btn-back {
  width: 100%;
  height: 72rpx;
  background: transparent !important;
  font-size: 26rpx;
  color: rgba(90,79,86,1.0) !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-back::after {
  border: none;
}

.btn-back text {
  color: rgba(90,79,86,1.0);
  font-size: 26rpx;
}

/* 隐藏的Canvas */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}
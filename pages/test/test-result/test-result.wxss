/* 测试结果页 - 深色渐变主题 */

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* 结果头部 */
.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 48rpx;
}

.result-emoji {
  font-size: 128rpx;
  margin-bottom: 24rpx;
}

.result-type {
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.result-test-name {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 12rpx;
}

/* 分数展示 */
.score-container {
  padding: 40rpx;
}

.score-display {
  display: flex;
  justify-content: center;
}

.score-chart {
  position: relative;
  width: 280rpx;
  height: 280rpx;
}

.score-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.score-number {
  font-size: 84rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.score-unit {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
}

.score-ring {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  z-index: 1;
}

/* 结果描述卡片 */
.description-card,
.details-card,
.info-card,
.recommend-card {
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 32rpx;
  border: 1px solid rgba(255,255,255,0.1);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-more {
  font-size: 24rpx;
  color: #FF6B35;
}

/* 描述内容 */
.description-content {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.8;
  padding: 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
}

/* 详细数据 */
.details-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.detail-key {
  width: 100rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
}

.detail-bar {
  flex: 1;
  height: 16rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 8rpx;
  overflow: hidden;
}

.detail-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FF006E 100%);
  border-radius: 8rpx;
}

.detail-value {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

/* 信息卡片 */
.info-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
}

.info-value {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 操作按钮 */
.action-container {
  padding: 40rpx 32rpx;
}

.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.btn-half {
  flex: 1;
}

.btn-block {
  width: 100%;
  height: 92rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-block::after {
  border: none;
}

.btn-block text {
  font-size: 30rpx;
  line-height: 1.4;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 推荐列表 */
.recommend-items {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  border: 1px solid rgba(255,255,255,0.08);
  transition: all 0.3s ease;
}

.recommend-item:active {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,107,53,0.3);
}

.recommend-emoji {
  font-size: 56rpx;
  flex-shrink: 0;
}

.recommend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.recommend-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

.recommend-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.recommend-people {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

.recommend-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.4);
}

/* 底部空白 */
.bottom-space {
  height: 120rpx;
}

/* ==================== 解锁区（场景1） ==================== */
.unlock-section {
  margin: 24rpx 32rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
}
.unlock-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}
.unlock-desc {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.vip-hint {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.2) 0%, rgba(255, 165, 0, 0.15) 100%);
  border: 1rpx solid rgba(255, 107, 107, 0.4);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}
.vip-hint-icon { font-size: 44rpx; margin-bottom: 12rpx; }
.vip-hint-title { color: #fff; font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.vip-hint-desc { color: rgba(255,255,255,0.75); font-size: 26rpx; line-height: 1.7; white-space: pre-line; }
.vip-hint-highlight { color: #FFA500; font-weight: 600; }

.unlock-buttons { display: flex; flex-direction: column; gap: 20rpx; }
.btn-ad {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 2rpx dashed rgba(255,255,255,0.3);
  border-radius: 20rpx;
}
.btn-ad-title { display: flex; align-items: center; gap: 12rpx; color: rgba(255,255,255,0.75); font-size: 28rpx; }
.btn-ad-tag { background: rgba(34,197,94,0.2); color: #22C55E; padding: 4rpx 14rpx; border-radius: 12rpx; font-size: 22rpx; }
.btn-ad-arrow { color: rgba(255,255,255,0.5); font-size: 28rpx; }

.btn-single {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx;
  border: 2rpx solid rgba(168,85,247,0.5);
  border-radius: 20rpx;
}
.btn-single-title { color: #fff; font-size: 30rpx; font-weight: 500; }
.btn-single-price { color: #A855F7; font-size: 32rpx; font-weight: 600; }

.btn-vip-special {
  position: relative; padding: 28rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFA500 100%);
  box-shadow: 0 8rpx 32rpx rgba(255,107,107,0.4);
  overflow: hidden;
}
.btn-vip-block { display: block; margin-bottom: 24rpx; }
.btn-vip-shine {
  position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%);
  animation: shine 3s infinite; pointer-events: none;
}
@keyframes shine { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
.btn-vip-content { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 1; }
.btn-vip-left { flex: 1; }
.btn-vip-title { color: #fff; font-size: 32rpx; font-weight: 600; }
.btn-vip-sub { color: rgba(255,255,255,0.9); font-size: 24rpx; margin-top: 6rpx; }
.btn-vip-price { text-align: right; }
.btn-vip-price-original { color: rgba(255,255,255,0.65); font-size: 22rpx; text-decoration: line-through; }
.btn-vip-price-special { color: #fff; font-size: 38rpx; font-weight: bold; margin-top: 4rpx; }
.btn-vip-price-special text { font-size: 22rpx; font-weight: normal; }
.exclusive-tag {
  position: absolute; top: -12rpx; right: 24rpx;
  background: linear-gradient(90deg, #FFD700, #FFA500); color: #000;
  font-size: 20rpx; padding: 4rpx 18rpx; border-radius: 16rpx; font-weight: 700; z-index: 2;
}

/* ==================== 场景2：底部常驻升级条 ==================== */
.sticky-upgrade {
  margin: 24rpx 32rpx; padding: 20rpx 24rpx;
  display: flex; align-items: center; gap: 16rpx;
  background: linear-gradient(90deg, rgba(255,107,107,0.2), rgba(255,165,0,0.2));
  border: 1rpx solid rgba(255,107,107,0.3);
  border-radius: 20rpx;
}
.sticky-upgrade-left { display: flex; align-items: center; gap: 12rpx; flex: 1; }
.sticky-upgrade-emoji { font-size: 32rpx; }
.sticky-upgrade-text { color: #fff; font-size: 24rpx; line-height: 1.6; white-space: pre-line; }
.sticky-upgrade-strong { color: #FFA500; font-weight: 600; }
.sticky-upgrade-btn {
  background: linear-gradient(90deg, #FF6B6B, #FFA500); color: #fff;
  font-size: 24rpx; font-weight: 600; padding: 14rpx 24rpx; border-radius: 14rpx;
}
.sticky-upgrade-close { color: rgba(255,255,255,0.4); font-size: 32rpx; padding: 0 8rpx; }

/* ==================== 弹窗 ==================== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex; justify-content: center; align-items: center; z-index: 1000;
}
.modal {
  width: 600rpx;
  background: linear-gradient(180deg, #1A1A2E 0%, #0F0F1A 100%);
  border-radius: 32rpx; padding: 40rpx 32rpx; position: relative;
}
.modal-close { position: absolute; top: 24rpx; right: 28rpx; color: rgba(255,255,255,0.5); font-size: 40rpx; line-height: 1; }
.modal-title { text-align: center; color: #fff; font-size: 34rpx; font-weight: 600; margin-bottom: 28rpx; }
.modal-highlight {
  background: linear-gradient(135deg, rgba(255,107,107,0.2) 0%, rgba(255,165,0,0.15) 100%);
  border-radius: 20rpx; padding: 28rpx 24rpx; margin-bottom: 28rpx; text-align: center;
}
.modal-highlight-text { color: #fff; font-size: 28rpx; line-height: 1.8; white-space: pre-line; }
.modal-strong { color: #FFA500; font-weight: 700; }
.modal-sub { color: rgba(255,255,255,0.7); font-size: 24rpx; }
.modal-benefits { margin-bottom: 28rpx; }
.benefit-item { display: flex; align-items: center; gap: 16rpx; color: rgba(255,255,255,0.85); font-size: 28rpx; padding: 12rpx 0; }
.benefit-check { color: #22C55E; }
.price-section { text-align: center; margin-bottom: 28rpx; }
.price-compare { color: rgba(255,255,255,0.5); font-size: 26rpx; text-decoration: line-through; margin-bottom: 8rpx; }
.price-main { color: #fff; font-size: 60rpx; font-weight: bold; line-height: 1; }
.price-unit { font-size: 26rpx; font-weight: normal; color: rgba(255,255,255,0.6); }
.price-save { color: #22C55E; font-size: 24rpx; margin-top: 12rpx; }
.pay-buttons { display: flex; gap: 20rpx; }
.pay-btn { flex: 1; text-align: center; padding: 24rpx 0; border-radius: 20rpx; font-size: 28rpx; font-weight: 600; }
.pay-btn-wechat { background: #07C160; color: #fff; }
.pay-btn-douyin { background: #000; color: #fff; border: 1rpx solid rgba(255,255,255,0.2); }
.pay-btn-single { background: rgba(168,85,247,0.3); color: #fff; border: 1rpx solid rgba(168,85,247,0.5); }
.pay-btn-ad { background: rgba(34,197,94,0.3); color: #fff; border: 1rpx solid rgba(34,197,94,0.5); }
.retest-pay { margin-top: 24rpx; }
.divider { display: flex; align-items: center; margin: 32rpx 0 8rpx; }
.divider-line { flex: 1; height: 1rpx; background: rgba(255,255,255,0.1); }
.divider-text { color: rgba(255,255,255,0.4); font-size: 24rpx; padding: 0 24rpx; }

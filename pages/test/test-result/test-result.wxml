<!-- 测试结果页面 -->
<scroll-view scroll-y class="page-scroll">
  <!-- 结果header -->
  <view class="result-header">
    <text class="result-emoji">{{result.emoji || '🎯'}}</text>
    <text class="result-type">{{result.title || result.type || '测试完成'}}</text>
    <text class="result-test-name">{{testName}}</text>
  </view>

  <!-- 分数展示 -->
  <view class="score-container">
    <view class="score-display">
      <view class="score-chart">
        <view class="score-circle">
          <text class="score-number">{{result.score || 0}}</text>
          <text class="score-unit">分</text>
        </view>
        <view class="score-ring" style="background: conic-gradient(#DC8DA8 0deg {{(result.score || 0) / 100 * 360}}deg, #2A2A3E {{(result.score || 0) / 100 * 360}}deg 360deg)"></view>
      </view>
    </view>
  </view>

  <!-- ============ 基础结果（始终可见） ============ -->
  <!-- 结果描述：一句话结论，免费看 -->
  <view class="description-card">
    <view class="card-title">📋 结果解读</view>
    <view class="description-content">
      <text>{{result.description || '感谢完成测试！'}}</text>
    </view>
  </view>

  <!-- 完成信息：基础元数据 -->
  <view class="info-card">
    <view class="info-item">
      <text class="info-label">完成时间</text>
      <text class="info-value">{{completedAt}}</text>
    </view>
    <view class="info-item" wx:if="{{result.correctCount !== undefined}}">
      <text class="info-label">答对题数</text>
      <text class="info-value">{{result.correctCount}} / {{result.totalQuestions}}</text>
    </view>
  </view>

  <!-- ============ 场景1：未解锁视图（深度内容前的解锁 CTA） ============ -->
  <view wx:if="{{!unlocked}}" class="unlock-section">
    <view class="unlock-title">🔒 解锁深度解读</view>
    <view class="unlock-desc">包含：维度详情、性格画像、专属建议</view>

    <!-- 深度内容预览（蒙版/模糊预览，提升解锁意愿） -->
    <view class="deep-preview" wx:if="{{result.details || result.traits}}">
      <view class="deep-preview-mask">
        <view class="detail-item deep-preview-item" wx:for="{{result.details || result.traits}}" wx:for-index="key" wx:for-item="value" wx:key="key">
          <text class="detail-key">{{key}}</text>
          <view class="detail-bar">
            <view class="detail-fill" style="width: {{value * 10}}%"></view>
          </view>
          <text class="detail-value">{{value}}</text>
        </view>
      </view>
      <view class="deep-preview-cover">🔒 解锁查看完整详情</view>
    </view>

    <view class="unlock-buttons">
      <view class="btn-ad" bindtap="onWatchAd" wx:if="{{enableAdUnlock}}">
        <view class="btn-ad-title">
          <text>📺 看广告解锁</text>
          <text class="btn-ad-tag">免费</text>
        </view>
        <view class="btn-ad-arrow"></view>
      </view>

      <view class="btn-single" bindtap="onPaySingle">
        <text class="btn-single-title">💎 单次解锁</text>
        <text class="btn-single-price">¥3.9</text>
      </view>

      <view class="btn-vip-special" bindtap="onShowUpgradeModal">
        <view class="btn-vip-shine"></view>
        <view class="btn-vip-content">
          <view class="btn-vip-left">
            <view class="btn-vip-title">👑 全站永久</view>
            <view class="btn-vip-sub">永久解锁全部测试</view>
          </view>
          <view class="btn-vip-price">
            <view class="btn-vip-price-original">¥19.9</view>
            <view class="btn-vip-price-special">¥9.9<text>永久</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 深度内容（已解锁可见） ============ -->
  <block wx:if="{{unlocked}}">
    <!-- 详细维度数据 -->
    <view class="details-card" wx:if="{{result.details || result.traits}}">
      <view class="card-title">📊 详细数据</view>
      <view class="details-content">
        <view class="detail-item" wx:for="{{result.details || result.traits}}" wx:for-index="key" wx:for-item="value" wx:key="key">
          <text class="detail-key">{{key}}</text>
          <view class="detail-bar">
            <view class="detail-fill" style="width: {{value * 10}}%"></view>
          </view>
          <text class="detail-value">{{value}}</text>
        </view>
      </view>
    </view>

    <!-- ============ 底部常驻升级条（非会员可见）============ -->
    <view wx:if="{{showStickyUpgrade && !isVip}}" class="sticky-upgrade">
      <view class="sticky-upgrade-left">
        <text class="sticky-upgrade-emoji">💡</text>
        <view class="sticky-upgrade-text">
          全站永久解锁{{'\n'}}
          限时<text class="sticky-upgrade-strong">¥9.9</text>（原价¥19.9）
        </view>
      </view>
      <view class="sticky-upgrade-btn" bindtap="onShowUpgradeModal">立即解锁</view>
      <view class="sticky-upgrade-close" bindtap="onCloseSticky">
        <view class="close-line"></view>
        <view class="close-line"></view>
      </view>
    </view>
  </block>

  <!-- ============ 操作按钮（始终可见） ============ -->
  <view class="action-container">
    <button class="btn btn-primary btn-block" bindtap="onShare">
      <text class="btn-icon">📤</text>
      <text>复制结果</text>
    </button>
    <view class="btn-row">
      <button class="btn btn-secondary btn-half" bindtap="onRetake">
        <text class="btn-icon">🔄</text>
        <text>重新测试</text>
      </button>
      <button class="btn btn-secondary btn-half" bindtap="onSaveResult">
        <text class="btn-icon">💾</text>
        <text>保存结果</text>
      </button>
    </view>
  </view>

  <!-- ============ 推荐测试（始终可见，导流） ============ -->
  <view class="recommend-card" wx:if="{{recommendTests.length > 0}}">
    <view class="card-header">
      <text class="card-title">🔥 更多测试推荐</text>
      <view class="card-more" bindtap="onViewAllTests">
        <text>查看全部</text>
        <view class="more-arrow"></view>
      </view>
    </view>
    <view class="recommend-items">
      <view class="recommend-item" wx:for="{{recommendTests}}" wx:key="id" bindtap="onOpenTest" data-id="{{item.id}}">
        <text class="recommend-emoji">{{item.emoji}}</text>
        <view class="recommend-info">
          <text class="recommend-name">{{item.name}}</text>
          <text class="recommend-desc">{{item.description}}</text>
        </view>
        <view class="recommend-stats">
          <text class="recommend-people">{{item.participantsText}}人</text>
          <view class="recommend-arrow"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</scroll-view>

<!-- ============ 全站永久解锁弹窗 ============ -->
<view wx:if="{{showUpgradeModal}}" class="modal-overlay" bindtap="onCloseUpgradeModal">
  <view class="modal" catchtap="">
    <view class="modal-close" bindtap="onCloseUpgradeModal">
      <view class="close-line"></view>
      <view class="close-line"></view>
    </view>
    <view class="modal-title">👑 全站永久解锁</view>

    <view class="modal-highlight">
      <view class="modal-highlight-text">
        一次付费 <text class="modal-strong">¥9.9</text>，永久解锁全部测试{{'\n'}}
        <text class="modal-sub">限时特价 · 原价 ¥19.9</text>
      </view>
    </view>

    <view class="modal-benefits">
      <view class="benefit-item"><text class="benefit-check">✅</text> 永久无限次生成互动报告</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 所有测试完整解读</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 所有海报模板</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 测试历史永久保存</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 永久会员专属标识</view>
    </view>

    <view class="price-section">
      <view class="price-compare">原价 ¥19.9</view>
      <view class="price-main">¥9.9<text class="price-unit">永久</text></view>
      <view class="price-save">限时特价 · 一次买断永久使用</view>
    </view>

    <view class="pay-buttons">
      <view class="pay-btn pay-btn-wechat" bindtap="onPayVip">立即永久解锁 ¥9.9</view>
    </view>
  </view>
</view>


/* 记录列表页 - 深色渐变主题 */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* 搜索栏 */
.search-container {
  padding: 24rpx 32rpx;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.08);
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  gap: 16rpx;
}

.search-icon {
  font-size: 32rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: normal;
}

.clear-icon {
  font-size: 32rpx;
  color: rgba(255,255,255,0.4);
  padding: 8rpx;
}

/* 分类导航 */
.category-scroll {
  white-space: nowrap;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.category-container {
  display: inline-flex;
  padding: 24rpx 32rpx;
  gap: 20rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(255,107,53,0.3);
}

/* 排序选项 */
.sort-container {
  display: flex;
  padding: 20rpx 32rpx;
  gap: 32rpx;
  background: rgba(255,255,255,0.03);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}

.sort-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.sort-item.active {
  color: #FF6B35;
  background: rgba(255,107,53,0.15);
  font-weight: 600;
}

.sort-icon {
  font-size: 28rpx;
}

/* 内容列表 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 280rpx);
}

.tree-list {
  padding: 32rpx;
}

.tree-item {
  padding: 32rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(255,255,255,0.08);
  transition: all 0.3s ease;
}

.tree-item:active {
  transform: translateY(-4rpx);
  border-color: rgba(255,107,53,0.3);
}

/* 顶部用户信息 */
.tree-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  font-size: 64rpx;
}

.user-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.user-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

.category-badge {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background: rgba(255,107,53,0.15);
  color: #FF6B35;
  border-radius: 40rpx;
  font-weight: 500;
}

/* 内容 */
.tree-content {
  margin-bottom: 24rpx;
}

.tree-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

/* 底部统计 */
.tree-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1px solid rgba(255,255,255,0.05);
}

.stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

.action-arrow {
  font-size: 36rpx;
  color: rgba(255,255,255,0.3);
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

/* 没有更多 */
.end-hint {
  padding: 40rpx;
  text-align: center;
}

.end-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  gap: 24rpx;
}

.empty-emoji {
  font-size: 128rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
}

/* 发布按钮 (悬浮) */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF006E 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(255,107,53,0.3);
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 48rpx;
}

/* 底部空白 */
.bottom-space {
  height: 200rpx;
}

.btn-icon {
  font-size: 32rpx;
}

/* 记录创建页面样式 - 梦幻渐变主题 */

page {
  background-color: #FBF7F9;
}

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #FBF7F9 0%, #F8F5FB 40%, #F5F3F8 100%);
}

/* 头部卡片 */
.header-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 64rpx 40rpx;
  margin: 32rpx;
  background: rgba(184,164,216,0.04);
  border-radius: 32rpx;
  border: 1px solid rgba(184,164,216,0.15);
}

.header-emoji {
  font-size: 96rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #7A6E7A;
}

.header-hint {
  font-size: 26rpx;
  color: rgba(122,110,122,1.0);
}

/* 分段 */
.section {
  margin: 0 32rpx 40rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #7A6E7A;
  margin-bottom: 24rpx;
}

/* 分类网格 */
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.category-choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 16rpx;
  background: rgba(184,164,216,0.04);
  border-radius: 24rpx;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.category-choice:active {
  transform: scale(0.95);
}

.category-choice.active {
  background: linear-gradient(135deg, #E8A8BF 0%, #B8A4D8 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 28rpx rgba(232,168,191,0.3);
}

.category-choice-emoji {
  font-size: 56rpx;
}

.category-choice-name {
  font-size: 24rpx;
  color: rgba(122,110,122,1.0);
  font-weight: 500;
}

.category-choice.active .category-choice-name {
  color: #7A6E7A;
}

/* 字数计数 */
.label-with-count {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.word-count {
  font-size: 24rpx;
  color: rgba(122,110,122,1.0);
}

.word-count.error {
  color: #E89AAA;
  font-weight: 600;
}

/* 文本框 */
.content-textarea {
  width: 100%;
  height: 360rpx;
  padding: 32rpx;
  background: rgba(184,164,216,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(184,164,216,0.15);
  font-size: 28rpx;
  color: #7A6E7A;
  line-height: 1.7;
}

.content-textarea:focus {
  border-color: #E8A8BF;
  box-shadow: 0 0 0 6rpx rgba(232,168,191,0.15);
}

.content-textarea.error {
  border-color: #E89AAA;
  background: rgba(232,154,170,0.05);
}

.textarea-placeholder {
  color: rgba(122,110,122,1.0);
}

/* 匿名切换 */
.anonymous-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: rgba(184,164,216,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(184,164,216,0.15);
}

.toggle-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #7A6E7A;
}

.toggle {
  width: 100rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.6);
  border: 1px solid rgba(184,164,216,0.15);
  display: flex;
  align-items: center;
  padding: 4rpx;
  transition: all 0.3s ease;
}

.toggle.active {
  background: linear-gradient(135deg, #E8A8BF 0%, #B8A4D8 100%);
  border-color: transparent;
}

.toggle-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 8rpx rgba(184,164,216,0.1);
  transition: all 0.3s ease;
}

.toggle.active .toggle-circle {
  transform: translateX(40rpx);
}

.toggle-hint {
  font-size: 24rpx;
  color: rgba(122,110,122,1.0);
  margin-top: 20rpx;
  padding: 0 8rpx;
}

/* 操作分段 */
.action-section {
  display: flex;
  gap: 24rpx;
  margin: 0 32rpx 40rpx;
}

.btn {
  flex: 1;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
  margin: 0;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn text {
  font-size: 28rpx;
  font-weight: 600;
}

.btn:active:not(.disabled) {
  transform: scale(0.98);
}

.btn-primary {
  background: linear-gradient(135deg, #E8A8BF 0%, #B8A4D8 100%) !important;
  color: #FFFFFF !important;
  box-shadow: 0 8rpx 28rpx rgba(232,168,191,0.3);
}

.btn-primary text {
  color: #7A6E7A;
}

.btn-primary.disabled {
  background: rgba(255,255,255,0.6) !important;
  color: rgba(122,110,122,1.0) !important;
  box-shadow: none;
  pointer-events: none;
}

.btn-secondary {
  background: rgba(184,164,216,0.04) !important;
  color: #7A6E7A !important;
  border: 1px solid rgba(184,164,216,0.15) !important;
}

.btn-secondary text {
  color: #7A6E7A;
}

.btn-icon {
  font-size: 32rpx;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}

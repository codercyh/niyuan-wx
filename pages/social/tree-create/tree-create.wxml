<!-- 记录创建页面 -->
<scroll-view scroll-y class="page-scroll">
  <!-- 头部提示 -->
  <view class="header-card">
    <text class="header-emoji">✍️</text>
    <text class="header-title">写下你的记录</text>
    <text class="header-hint">500字以内，方便自己保存和回看</text>
  </view>

  <!-- 分类选择 -->
  <view class="section">
    <text class="section-label">选择分类</text>
    <view class="category-grid">
      <view class="category-choice {{selectedCategory === 'love' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="love">
        <text class="category-choice-emoji">💕</text>
        <text class="category-choice-name">情感</text>
      </view>
      <view class="category-choice {{selectedCategory === 'work' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="work">
        <text class="category-choice-emoji">💼</text>
        <text class="category-choice-name">工作</text>
      </view>
      <view class="category-choice {{selectedCategory === 'family' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="family">
        <text class="category-choice-emoji">🏠</text>
        <text class="category-choice-name">家庭</text>
      </view>
      <view class="category-choice {{selectedCategory === 'friendship' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="friendship">
        <text class="category-choice-emoji">🤝</text>
        <text class="category-choice-name">友情</text>
      </view>
      <view class="category-choice {{selectedCategory === 'mood' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="mood">
        <text class="category-choice-emoji">💭</text>
        <text class="category-choice-name">心情</text>
      </view>
      <view class="category-choice {{selectedCategory === 'other' ? 'active' : ''}}" bindtap="onSelectCategory" data-category="other">
        <text class="category-choice-emoji">✨</text>
        <text class="category-choice-name">其他</text>
      </view>
    </view>
  </view>

  <!-- 内容输入 -->
  <view class="section">
    <view class="label-with-count">
      <text class="section-label">内容</text>
      <text class="word-count {{contentLength > 500 ? 'error' : ''}}">{{contentLength}}/500</text>
    </view>
    <textarea 
      class="content-textarea {{contentLength > 500 ? 'error' : ''}}" 
      placeholder="在这里写下你的想法、片段或当下状态..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
      placeholder-class="textarea-placeholder"
    ></textarea>
  </view>

  <!-- 匿名选项 -->
  <view class="section">
    <view class="anonymous-toggle">
      <text class="toggle-label">使用默认昵称</text>
      <view class="toggle {{isAnonymous ? 'active' : ''}}" bindtap="onToggleAnonymous">
        <view class="toggle-circle"></view>
      </view>
    </view>
    <text class="toggle-hint">{{isAnonymous ? '当前仅显示默认昵称' : '当前会显示你的昵称'}}</text>
  </view>

  <!-- 草稿和发布 -->
  <view class="action-section">
    <button class="btn btn-secondary" bindtap="onSaveDraft">
      <text class="btn-icon">💾</text>
      <text>保存草稿</text>
    </button>
    <button class="btn btn-primary {{canPublish ? '' : 'disabled'}}" bindtap="onPublish">
      <text class="btn-icon">📤</text>
      <text>保存记录</text>
    </button>
  </view>

  <view class="bottom-space"></view>
</scroll-view>

/* 记录详情页面样式 - 梦幻渐变主题 */

page {
  background-color: #FDF6F6;
}

.page-scroll {
  min-height: 100vh;
  background: linear-gradient(180deg, #FDF6F6 0%, #FFF8F0 40%, #F0F8F4 100%);
  padding-bottom: 140rpx;
}

/* 内容展示 */
.content-section {
  padding: 32rpx;
}

/* 用户卡 */
.user-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(157,212,184,0.15);
  margin-bottom: 24rpx;
}

.user-header {
  display: flex;
  gap: 24rpx;
  flex: 1;
}

.user-avatar {
  font-size: 80rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #6A6068;
}

.user-time {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

.category-badge {
  padding: 8rpx 24rpx;
  background: rgba(232,168,191,0.15);
  border-radius: 40rpx;
  color: #E8A8BF;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 内容框 */
.content-box {
  padding: 32rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(157,212,184,0.15);
  margin-bottom: 24rpx;
}

.content-text {
  font-size: 28rpx;
  color: #6A6068;
  line-height: 1.8;
  word-wrap: break-word;
}

/* 统计卡 */
.stats-card {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(157,212,184,0.15);
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8A8BF;
}

.divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.6);
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(157,212,184,0.04);
  border-radius: 24rpx;
  border: 1px solid rgba(157,212,184,0.15);
  font-size: 26rpx;
  color: #6A6068;
  font-weight: 500;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.action-btn.liked {
  background: rgba(232,168,191,0.15);
  color: #E8A8BF;
  border-color: rgba(232,168,191,0.3);
}

.action-icon {
  font-size: 32rpx;
}

.action-label {
  font-size: 26rpx;
}

/* 分割线 */
.divider-full {
  height: 16rpx;
  background: rgba(157,212,184,0.04);
  margin: 16rpx 0;
}

/* 补充区 */
.comments-section {
  padding: 32rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.title-emoji {
  font-size: 36rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #6A6068;
}

/* 补充列表 */
.comments-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-item {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.main-comment {
  display: flex;
  gap: 24rpx;
}

.comment-avatar {
  font-size: 64rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #6A6068;
}

.comment-time {
  font-size: 22rpx;
  color: rgba(106,96,104,1.0);
}

.comment-text {
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.comment-footer {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.comment-like,
.comment-reply {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
}

.comment-like.liked {
  color: #E8A8BF;
}

/* 二级补充列表 */
.replies {
  margin-left: 88rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid rgba(157,212,184,0.15);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.reply-item {
  display: flex;
  gap: 20rpx;
}

.reply-avatar {
  font-size: 48rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reply-content {
  flex: 1;
}

.reply-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.reply-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #6A6068;
}

.reply-time {
  font-size: 22rpx;
  color: rgba(106,96,104,1.0);
}

.reply-text {
  font-size: 24rpx;
  color: rgba(106,96,104,1.0);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.reply-like {
  font-size: 22rpx;
  color: rgba(106,96,104,1.0);
}

.reply-like.liked {
  color: #E8A8BF;
}

/* 无补充状态 */
.no-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 24rpx;
}

.no-comments-emoji {
  font-size: 96rpx;
}

.no-comments-text {
  font-size: 26rpx;
  color: rgba(106,96,104,1.0);
}

/* 底部输入框 */
.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15,12,41,0.95);
  border-top: 1px solid rgba(157,212,184,0.15);
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-container {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #6A6068;
}

.input-placeholder {
  color: rgba(106,96,104,1.0);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.6) !important;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none !important;
  transition: all 0.3s ease;
  margin: 0;
  line-height: 1;
}

.send-btn::after {
  border: none;
}

.send-btn text {
  font-size: 32rpx;
}

.send-btn.active {
  background: linear-gradient(135deg, #E8A8BF 0%, #9DD4B8 100%) !important;
  box-shadow: 0 4rpx 16rpx rgba(232,168,191,0.3);
}

.send-icon {
  font-size: 32rpx;
}

/* 底部空白 */
.bottom-space {
  height: 40rpx;
}

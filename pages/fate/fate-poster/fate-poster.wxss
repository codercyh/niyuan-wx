.poster-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

/* ==================== 预览区域 ==================== */
.preview-section {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.preview-card {
  width: 600rpx;
  height: 900rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
}

/* 搞怪风 */
.poster-funny {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.stars-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.star {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255,255,255,0.4);
  border-radius: 50%;
}

.star:nth-child(1) { top: 8%; left: 10%; }
.star:nth-child(2) { top: 15%; right: 15%; width: 6rpx; height: 6rpx; }
.star:nth-child(3) { top: 25%; right: 25%; }
.star:nth-child(4) { top: 35%; left: 20%; }
.star:nth-child(5) { top: 50%; right: 10%; }
.star:nth-child(6) { top: 65%; left: 15%; }
.star:nth-child(7) { top: 75%; right: 20%; }
.star:nth-child(8) { top: 85%; left: 30%; }

.poster-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.big-emoji {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.fate-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.fate-level {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 32rpx;
}

.score-big {
  font-size: 120rpx;
  font-weight: 800;
  color: #FF6B35;
  margin-bottom: 24rpx;
}

.names {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.tagline {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  font-style: italic;
  margin-bottom: 20rpx;
}

.hashtags {
  font-size: 22rpx;
  color: #00D9FF;
}

/* 文艺风 */
.poster-artistic {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #2C3E50 0%, #1B2745 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.artistic-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.artistic-header text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 4rpx;
}

.divider-line {
  width: 200rpx;
  height: 1px;
  background: rgba(255,255,255,0.2);
  margin-bottom: 48rpx;
}

.poster-artistic .fate-name {
  font-size: 40rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.names-simple {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 48rpx;
}

.score-artistic {
  font-size: 100rpx;
  font-weight: 300;
  color: #00D9FF;
  margin-bottom: 32rpx;
}

.poster-artistic .tagline {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

/* 极简风 */
.poster-minimal {
  width: 100%;
  height: 100%;
  background: #000000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.names-minimal {
  font-size: 36rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.fate-name-minimal {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 48rpx;
}

.score-minimal {
  font-size: 140rpx;
  font-weight: 800;
  color: #FF6B35;
  margin-bottom: 32rpx;
}

.tagline-minimal {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* 表情包风 */
.poster-meme {
  width: 100%;
  height: 100%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.meme-emoji {
  font-size: 180rpx;
  margin-bottom: 24rpx;
}

.fate-name-meme {
  font-size: 36rpx;
  color: #000000;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.score-meme {
  font-size: 60rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-bottom: 24rpx;
}

.names-meme {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.tagline-meme {
  font-size: 22rpx;
  color: #999999;
}

/* ==================== 风格选择 ==================== */
.style-section {
  margin-bottom: 32rpx;
}

.style-title {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 20rpx;
  text-align: center;
}

.style-list {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 32rpx;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.style-selected {
  background: rgba(255,107,53,0.15);
  border-color: #FF6B35;
}

.style-emoji {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.style-name {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* ==================== 操作按钮 ==================== */
.action-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.btn-save {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B35, #FF006E) !important;
  border-radius: 50rpx;
  border: none !important;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-save::after {
  border: none;
}

.btn-save text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-share {
  width: 100%;
  height: 88rpx;
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.2) !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-share::after {
  border: none;
}

.btn-share text {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
}

/* 隐藏Canvas */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}

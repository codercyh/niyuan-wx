.page {
  min-height: 100vh;
  background: radial-gradient(circle at 50% 30%, rgba(244, 124, 142, 0.10), transparent 30%), #FFF8F8;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx 60rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* ==================== 双卡连接动画 ==================== */
.connection-animation {
  width: 560rpx;
  height: 420rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

/* 呼吸外圈 */
.soft-ring {
  position: absolute;
  width: 380rpx;
  height: 380rpx;
  border: 1px solid rgba(244, 124, 142, 0.18);
  border-radius: 50%;
  animation: breathe 1.8s ease-in-out infinite;
}

/* 内层虚线圈缓慢旋转 */
.soft-ring::after {
  content: "";
  position: absolute;
  inset: 42rpx;
  border: 1px dashed rgba(114, 200, 177, 0.28);
  border-radius: 50%;
  animation: spin 8s linear infinite;
}

@keyframes breathe {
  0%, 100% { transform: scale(0.94); opacity: 0.6; }
  50% { transform: scale(1.04); opacity: 1; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 双人小卡 */
.mini-card {
  position: absolute;
  width: 148rpx;
  height: 190rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 44rpx rgba(92, 67, 79, 0.12);
  z-index: 2;
}

.mini-card.me-card {
  left: 40rpx;
  border: 4rpx solid #FFD9DF;
  animation: driftLeft 1.8s ease-in-out infinite;
}

.mini-card.ta-card {
  right: 40rpx;
  border: 4rpx solid #DDF3EC;
  animation: driftRight 1.8s ease-in-out infinite;
}

@keyframes driftLeft {
  0%, 100% { transform: translateX(-8rpx) rotate(-2deg); }
  50% { transform: translateX(8rpx) rotate(0deg); }
}

@keyframes driftRight {
  0%, 100% { transform: translateX(8rpx) rotate(2deg); }
  50% { transform: translateX(-8rpx) rotate(0deg); }
}

.mini-face {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 800;
}

.mini-face.me {
  color: #E96379;
  background: #FFF1F3;
}

.mini-face.ta {
  color: #438F7A;
  background: #EFF9F5;
}

.mini-name {
  font-size: 22rpx;
  color: #756A72;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 中间连接线 */
.connector {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 144rpx;
  height: 6rpx;
  transform: translate(-50%, -50%);
  overflow: hidden;
  background: #EFE4E7;
  border-radius: 99rpx;
}

.connector-flow {
  width: 55%;
  height: 100%;
  background: linear-gradient(90deg, #F47C8E, #72C8B1);
  border-radius: inherit;
  animation: connect 1.5s ease-in-out infinite;
}

@keyframes connect {
  0% { transform: translateX(-100%); }
  55%, 100% { transform: translateX(190%); }
}

/* ==================== 文案 ==================== */
.loading-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #382F36;
  margin-bottom: 16rpx;
}

.loading-subtitle {
  font-size: 28rpx;
  color: #756A72;
  margin-bottom: 48rpx;
}

/* ==================== 百分比 ==================== */
.percent {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: #382F36;
  margin-bottom: 26rpx;
}

/* ==================== 进度条 ==================== */
.progress-track {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  background: #F1E6E9;
  border-radius: 999rpx;
}

.progress-value {
  height: 100%;
  background: linear-gradient(90deg, #F58A99 0%, #72C8B1 100%);
  border-radius: 999rpx;
  transition: width 0.25s ease;
}

/* ==================== 整理项目清单 ==================== */
.check-list {
  width: 100%;
  margin-top: 58rpx;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 86rpx;
  color: #AA9FA5;
  font-size: 28rpx;
  transition: color 0.3s ease, transform 0.3s ease;
}

.check-item.done {
  color: #382F36;
  transform: translateX(6rpx);
}

.check-dot {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  color: transparent;
  font-size: 26rpx;
  background: #EEE5E8;
  transition: all 0.3s ease;
}

.check-item.done .check-dot {
  color: #FFFFFF;
  background: #72C8B1;
  box-shadow: 0 8rpx 24rpx rgba(114, 200, 177, 0.24);
}

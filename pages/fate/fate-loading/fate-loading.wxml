<view class="page">
  <!-- 双卡连接动画 -->
  <view class="connection-animation">
    <view class="soft-ring"></view>
    <view class="mini-card me-card">
      <view class="mini-face me">你</view>
      <view class="mini-name">{{myName}}</view>
    </view>
    <view class="connector">
      <view class="connector-flow"></view>
    </view>
    <view class="mini-card ta-card">
      <view class="mini-face ta">TA</view>
      <view class="mini-name">{{taName}}</view>
    </view>
  </view>

  <!-- 主文案 -->
  <view class="loading-title">正在生成互动报告</view>
  <view class="loading-subtitle">正在整理双方信息，请稍候</view>

  <!-- 百分比 -->
  <view class="percent">{{progress}}%</view>

  <!-- 进度条 -->
  <view class="progress-track">
    <view class="progress-value" style="width: {{progress}}%"></view>
  </view>

  <!-- 整理项目清单 -->
  <view class="check-list">
    <view
      class="check-item {{item.status === 'done' ? 'done' : ''}}"
      wx:for="{{steps}}"
      wx:key="label"
    >
      <view class="check-dot">✓</view>
      <view class="check-label">{{item.label}}</view>
    </view>
  </view>
</view>

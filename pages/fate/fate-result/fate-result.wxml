<scroll-view scroll-y class="result-page">
  <!-- 顶部互动报告卡片（浅色渐变） -->
  <view class="fate-header" style="background: {{result.level.bgGradient || 'linear-gradient(135deg, #FFF1F3 0%, #DDF3EC 100%)'}}">

    <!-- 互动类型 -->
    <view class="fate-type-section">
      <text class="fate-emoji">{{result.fateType.emoji}}</text>
      <view class="fate-title">「{{result.fateType.name}}」</view>
      <view class="fate-level">{{result.level.level}}级 · {{result.level.label}}</view>
    </view>

    <!-- 分数环 -->
    <view class="score-ring-wrap">
      <view class="score-ring" style="background: conic-gradient({{result.level.color}} 0deg {{scoreAngle}}deg, #F0E4E7 {{scoreAngle}}deg 360deg)">
        <view class="score-inner">
          <text class="score-num">{{result.score}}</text>
        </view>
      </view>
    </view>

    <!-- 姓名组合 -->
    <view class="names-row">
      <text class="name-text">{{result.personA.name}}</text>
      <text class="zodiac-emoji">{{result.zodiacA.emoji}}</text>
      <text class="name-x">×</text>
      <text class="zodiac-emoji">{{result.zodiacB.emoji}}</text>
      <text class="name-text">{{result.personB.name}}</text>
    </view>

    <!-- 金句 -->
    <view class="tagline">"{{result.fateType.tagline}}"</view>

    <!-- 话题标签 -->
    <view class="hashtags">
      <text class="hashtag" wx:for="{{result.fateType.hashtags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- ============ 基础解读（始终可见，免费） ============ -->
  <!-- 维度速览：基础数据，免费看 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">📊</text>
      <text class="section-title">互动维度</text>
    </view>
    <view class="dimension-list">
      <view class="dim-item" wx:for="{{result.dimensionList}}" wx:key="key">
        <view class="dim-header">
          <text class="dim-emoji">{{item.emoji}}</text>
          <text class="dim-name">{{item.name}}</text>
          <text class="dim-score" style="color: {{item.color}}">{{item.score}}</text>
        </view>
        <view class="dim-bar-bg">
          <view class="dim-bar-fill" style="width: {{item.percentage}}%; background: {{item.color}}"></view>
        </view>
        <text class="dim-desc" wx:if="{{unlocked}}">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- ============ 场景1：未解锁视图（深度内容前的解锁 CTA） ============ -->
  <view wx:if="{{!unlocked}}" class="unlock-section">
    <view class="unlock-title">🔒 解锁深度解读</view>
    <view class="unlock-desc">包含：默契分析、相处指南、专属文案</view>

    <!-- 深度内容预览（标题清单，提升解锁意愿） -->
    <view class="deep-preview">
      <view class="deep-preview-item">💕 你们的互动特点</view>
      <view class="deep-preview-item">💬 你们的日常对话</view>
      <view class="deep-preview-item">⚔️ 会吵架的 TOP 3</view>
      <view class="deep-preview-item">💡 相处建议</view>
      <view class="deep-preview-item">✍️ 朋友圈分享文案</view>
    </view>

    <view class="unlock-buttons">
      <!-- 看广告解锁 -->
      <view class="btn-ad" bindtap="onWatchAd" wx:if="{{enableAdUnlock}}">
        <view class="btn-ad-title">
          <text>📺 看广告解锁</text>
          <text class="btn-ad-tag">免费</text>
        </view>
        <view class="btn-ad-arrow"></view>
      </view>

      <!-- 单次付费 -->
      <view class="btn-single" bindtap="onPaySingle">
        <text class="btn-single-title">💎 单次解锁</text>
        <text class="btn-single-price">¥3.9</text>
      </view>

      <!-- 全站永久 -->
      <view class="btn-vip-special" bindtap="onShowUpgradeModal">
        <view class="btn-vip-shine"></view>
        <view class="btn-vip-content">
          <view class="btn-vip-left">
            <view class="btn-vip-title">👑 全站永久</view>
            <view class="btn-vip-sub">永久解锁全部测试</view>
          </view>
          <view class="btn-vip-price">
            <view class="btn-vip-price-original">¥19.9</view>
            <view class="btn-vip-price-special">¥9.9<text>永久</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 深度解读（已解锁可见） ============ -->
  <block wx:if="{{unlocked}}">
    <!-- 为什么你们吸引 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-emoji">💕</text>
        <text class="section-title">你们的互动特点</text>
      </view>
      <view class="content-text">{{result.whyAttract}}</view>
    </view>

    <!-- 你们的日常 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-emoji">💬</text>
        <text class="section-title">你们的日常</text>
      </view>
      <view class="dialogue-box">
        <view class="dialogue-line {{item.speaker === 'A' ? 'dialogue-left' : 'dialogue-right'}}"
          wx:for="{{result.dailyDialogue.lines}}" wx:key="index">
          <view class="dialogue-bubble">
            <text class="dialogue-name">{{item.zodiac.emoji || '✨'}} {{item.name}}</text>
            <text class="dialogue-text">"{{item.text}}"</text>
          </view>
        </view>
      </view>
      <view class="dialogue-comment">{{result.dailyDialogue.comment}}</view>
    </view>

    <!-- 会吵架的事 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-emoji">⚔️</text>
        <text class="section-title">你们会吵架的事</text>
      </view>
      <view class="conflict-list">
        <view class="conflict-item conflict-rank-{{item.rank}}" wx:for="{{result.conflictTopics}}" wx:key="rank">
          <view class="conflict-rank">
            <text wx:if="{{item.rank === 1}}">👑</text>
            <text wx:elif="{{item.rank === 2}}">🥈</text>
            <text wx:else>🥉</text>
            <text class="rank-text">TOP {{item.rank}}</text>
          </view>
          <view class="conflict-content">
            <text class="conflict-title">{{item.title}}</text>
            <text class="conflict-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 相处秘籍 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-emoji">💡</text>
        <text class="section-title">相处建议</text>
      </view>
      <view class="advice-list">
        <view class="advice-item" wx:for="{{result.adviceList}}" wx:key="title">
          <view class="advice-num">{{index + 1}}</view>
          <view class="advice-content">
            <text class="advice-title">{{item.title}}</text>
            <text class="advice-desc">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 关系状态特殊提示 -->
    <view class="section-card special-hint-card" wx:if="{{result.specialHint}}">
      <view class="special-hint-title">{{result.specialHint.title}}</view>
      <view class="special-hint-content">{{result.specialHint.content}}</view>
      <view class="special-hint-tips">
        <view class="tip-item" wx:for="{{result.specialHint.tips}}" wx:key="*this">
          <text class="tip-dot">•</text>
          <text>{{item}}</text>
        </view>
      </view>
      <view class="special-hint-ending">"{{result.specialHint.ending}}"</view>
    </view>

    <!-- 分享文案 -->
    <view class="section-card">
      <view class="section-header">
        <text class="section-emoji">✍️</text>
        <text class="section-title">分享文案（一键复制）</text>
      </view>
      <view class="moments-list">
        <view class="moments-item" wx:for="{{result.momentsText}}" wx:key="style">
          <view class="moments-style">{{item.style}}</view>
          <view class="moments-content">"{{item.content}}"</view>
          <view class="moments-copy" data-text="{{item.content}}" bindtap="onCopyText">
            <text>复制</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ============ 底部常驻升级条（非会员可见）============ -->
    <view wx:if="{{showStickyUpgrade && !isVip}}" class="sticky-upgrade">
      <view class="sticky-upgrade-left">
        <text class="sticky-upgrade-emoji">💡</text>
        <view class="sticky-upgrade-text">
          全站永久解锁{{'\n'}}
          限时<text class="sticky-upgrade-strong">¥9.9</text>（原价¥19.9）
        </view>
      </view>
      <view class="sticky-upgrade-btn" bindtap="onShowUpgradeModal">立即解锁</view>
      <view class="sticky-upgrade-close" bindtap="onCloseSticky">
        <view class="close-line"></view>
        <view class="close-line"></view>
      </view>
    </view>
  </block>

  <!-- ============ 底部操作（始终可见） ============ -->
  <view class="action-section">
    <button class="btn-poster" bindtap="onGeneratePoster">
      <text class="btn-icon">🎨</text>
      <text>生成分享卡</text>
    </button>
    <view class="action-row">
      <button class="btn-secondary" bindtap="onSaveRecord">保存记录</button>
      <button class="btn-secondary" bindtap="onRetry">重新生成</button>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disclaimer-icon">🌿</text>
    <text class="disclaimer-text">本内容用于娱乐和互动交流，仅供参考。好的关系需要两个人一起用心经营~</text>
  </view>

  <view class="bottom-spacer"></view>
</scroll-view>

<!-- ============ 全站永久解锁弹窗 ============ -->
<view wx:if="{{showUpgradeModal}}" class="modal-overlay" bindtap="onCloseUpgradeModal">
  <view class="modal" catchtap="">
    <view class="modal-close" bindtap="onCloseUpgradeModal">
      <view class="close-line"></view>
      <view class="close-line"></view>
    </view>
    <view class="modal-title">👑 全站永久解锁</view>

    <view class="modal-highlight">
      <view class="modal-highlight-text">
        一次付费 <text class="modal-strong">¥9.9</text>，永久解锁全部测试{{'\n'}}
        <text class="modal-sub">限时特价 · 原价 ¥19.9</text>
      </view>
    </view>

    <view class="modal-benefits">
      <view class="benefit-item"><text class="benefit-check">✅</text> 永久无限次生成互动报告</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 所有测试完整解读</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 所有海报模板</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 测试历史永久保存</view>
      <view class="benefit-item"><text class="benefit-check">✅</text> 永久会员专属标识</view>
    </view>

    <view class="price-section">
      <view class="price-compare">原价 ¥19.9</view>
      <view class="price-main">¥9.9<text class="price-unit">永久</text></view>
      <view class="price-save">限时特价 · 一次买断永久使用</view>
    </view>

    <view class="pay-buttons">
      <view class="pay-btn pay-btn-wechat" bindtap="onPayVip">立即永久解锁 ¥9.9</view>
    </view>
  </view>
</view>


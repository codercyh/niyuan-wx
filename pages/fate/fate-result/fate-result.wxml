<scroll-view scroll-y class="result-page">
  <!-- 顶部缘分卡片 -->
  <view class="fate-header" style="background: {{result.level.bgGradient || 'linear-gradient(135deg, #FF6B35, #FF006E)'}}">
    <!-- 背景装饰 -->
    <view class="header-glow"></view>
    
    <!-- 缘分类型 -->
    <view class="fate-type-section">
      <text class="fate-emoji">{{result.fateType.emoji}}</text>
      <view class="fate-title">「{{result.fateType.name}}」</view>
      <view class="fate-level">{{result.level.level}}级 · {{result.level.label}}</view>
    </view>
    
    <!-- 分数环 -->
    <view class="score-ring-wrap">
      <view class="score-ring" style="background: conic-gradient({{result.level.color}} 0deg {{scoreAngle}}deg, rgba(255,255,255,0.15) {{scoreAngle}}deg 360deg)">
        <view class="score-inner">
          <text class="score-num">{{result.score}}</text>
        </view>
      </view>
    </view>
    
    <!-- 姓名组合 -->
    <view class="names-row">
      <text class="name-text">{{result.personA.name}}</text>
      <text class="zodiac-emoji">{{result.zodiacA.emoji}}</text>
      <text class="name-x">×</text>
      <text class="zodiac-emoji">{{result.zodiacB.emoji}}</text>
      <text class="name-text">{{result.personB.name}}</text>
    </view>
    
    <!-- 金句 -->
    <view class="tagline">"{{result.fateType.tagline}}"</view>
    
    <!-- 话题标签 -->
    <view class="hashtags">
      <text class="hashtag" wx:for="{{result.fateType.hashtags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
  
  <!-- 维度速览 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">📊</text>
      <text class="section-title">各维度得分</text>
    </view>
    <view class="dimension-list">
      <view class="dim-item" wx:for="{{result.dimensionList}}" wx:key="key">
        <view class="dim-header">
          <text class="dim-emoji">{{item.emoji}}</text>
          <text class="dim-name">{{item.name}}</text>
          <text class="dim-score" style="color: {{item.color}}">{{item.score}}</text>
        </view>
        <view class="dim-bar-bg">
          <view class="dim-bar-fill" style="width: {{item.percentage}}%; background: {{item.color}}"></view>
        </view>
        <text class="dim-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
  
  <!-- 为什么你们吸引 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">💕</text>
      <text class="section-title">为什么你们互相吸引</text>
    </view>
    <view class="content-text">{{result.whyAttract}}</view>
  </view>
  
  <!-- 你们的日常 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">💬</text>
      <text class="section-title">你们的日常</text>
    </view>
    <view class="dialogue-box">
      <view class="dialogue-line {{item.speaker === 'A' ? 'dialogue-left' : 'dialogue-right'}}" 
        wx:for="{{result.dailyDialogue.lines}}" wx:key="index">
        <view class="dialogue-bubble">
          <text class="dialogue-name">{{item.zodiac.emoji}} {{item.name}}</text>
          <text class="dialogue-text">"{{item.text}}"</text>
        </view>
      </view>
    </view>
    <view class="dialogue-comment">{{result.dailyDialogue.comment}}</view>
  </view>
  
  <!-- 会吵架的事 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">⚔️</text>
      <text class="section-title">你们会吵架的事</text>
    </view>
    <view class="conflict-list">
      <view class="conflict-item conflict-rank-{{item.rank}}" wx:for="{{result.conflictTopics}}" wx:key="rank">
        <view class="conflict-rank">
          <text wx:if="{{item.rank === 1}}">👑</text>
          <text wx:elif="{{item.rank === 2}}">🥈</text>
          <text wx:else>🥉</text>
          <text class="rank-text">TOP {{item.rank}}</text>
        </view>
        <view class="conflict-content">
          <text class="conflict-title">{{item.title}}</text>
          <text class="conflict-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 相处秘籍 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">💡</text>
      <text class="section-title">相处秘籍</text>
    </view>
    <view class="advice-list">
      <view class="advice-item" wx:for="{{result.adviceList}}" wx:key="title">
        <view class="advice-num">{{index + 1}}</view>
        <view class="advice-content">
          <text class="advice-title">{{item.title}}</text>
          <text class="advice-desc">{{item.content}}</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 关系状态特殊提示 -->
  <view class="section-card special-hint-card" wx:if="{{result.specialHint}}">
    <view class="special-hint-title">{{result.specialHint.title}}</view>
    <view class="special-hint-content">{{result.specialHint.content}}</view>
    <view class="special-hint-tips">
      <view class="tip-item" wx:for="{{result.specialHint.tips}}" wx:key="*this">
        <text class="tip-dot">•</text>
        <text>{{item}}</text>
      </view>
    </view>
    <view class="special-hint-ending">"{{result.specialHint.ending}}"</view>
  </view>
  
  <!-- 分享文案 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-emoji">✍️</text>
      <text class="section-title">分享文案（一键复制）</text>
    </view>
    <view class="moments-list">
      <view class="moments-item" wx:for="{{result.momentsText}}" wx:key="style">
        <view class="moments-style">{{item.style}}</view>
        <view class="moments-content">"{{item.content}}"</view>
        <view class="moments-copy" data-text="{{item.content}}" bindtap="onCopyText">
          <text>复制</text>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 底部操作 -->
  <view class="action-section">
    <button class="btn-poster" bindtap="onGeneratePoster">
      <text class="btn-icon">🎨</text>
      <text>生成分享海报</text>
    </button>
    <view class="action-row">
      <button class="btn-secondary" bindtap="onSaveRecord">保存记录</button>
      <button class="btn-secondary" bindtap="onRetry">重新测试</button>
    </view>
  </view>
  
  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disclaimer-icon">🎭</text>
    <text class="disclaimer-text">本测试仅供娱乐参考，真正的缘分需要两个人一起用心经营~</text>
  </view>
  
  <view class="bottom-spacer"></view>
</scroll-view>

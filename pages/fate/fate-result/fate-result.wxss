/* 结果页 - 深色渐变背景 */
.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FCEEEE 0%, #FFF0E8 40%, #E8F5EE 100%);
}

/* ==================== 顶部缘分卡片（沉浸式深色渐变 + 星空光点）==================== */
.fate-header {
  position: relative;
  margin: 24rpx;
  padding: 56rpx 32rpx 48rpx;
  text-align: center;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(90,58,82,0.35);
}

/* 星空光点装饰层 */
.header-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.star {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.8);
  box-shadow: 0 0 8rpx rgba(255,255,255,0.6);
}

.star-1 { top: 12%; left: 15%; width: 4rpx; height: 4rpx; }
.star-2 { top: 20%; left: 82%; width: 6rpx; height: 6rpx; }
.star-3 { top: 35%; left: 8%; width: 3rpx; height: 3rpx; opacity: 0.6; }
.star-4 { top: 48%; left: 90%; width: 5rpx; height: 5rpx; }
.star-5 { top: 65%; left: 18%; width: 4rpx; height: 4rpx; opacity: 0.7; }
.star-6 { top: 75%; left: 78%; width: 3rpx; height: 3rpx; }

.fate-type-section {
  margin-bottom: 24rpx;
}

.fate-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}

.fate-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.fate-level {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
}

/* 分数环 */
.score-ring-wrap {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255,255,255,0.2);
}

.score-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
}

/* 姓名组合 */
.names-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.name-text {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.95);
}

.zodiac-emoji {
  font-size: 28rpx;
}

.name-x {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin: 0 8rpx;
}

/* 金句 */
.tagline {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  font-style: italic;
  margin-bottom: 20rpx;
}

/* 话题标签 */
.hashtags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hashtag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.18);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* ==================== 通用卡片 ==================== */
.section-card {
  margin: 24rpx 32rpx;
  background: rgba(124,196,160,0.08);
  border: 1px solid rgba(124,196,160,0.32);
  border-radius: 32rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-emoji {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4F56;
}

.content-text {
  font-size: 28rpx;
  color: rgba(90,79,86,1.0);
  line-height: 1.8;
}

/* ==================== 维度列表 ==================== */
.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dim-item {
  width: 100%;
}

.dim-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dim-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.dim-name {
  font-size: 26rpx;
  color: rgba(90,79,86,1.0);
  flex: 1;
}

.dim-score {
  font-size: 28rpx;
  font-weight: 700;
}

.dim-bar-bg {
  height: 10rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s ease;
}

.dim-desc {
  font-size: 22rpx;
  color: rgba(90,79,86,1.0);
}

/* ==================== 对话样式 ==================== */
.dialogue-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dialogue-line {
  display: flex;
}

.dialogue-left {
  justify-content: flex-start;
}

.dialogue-right {
  justify-content: flex-end;
}

.dialogue-bubble {
  max-width: 70%;
  background: rgba(255,255,255,0.6);
  border: 1px solid rgba(124,196,160,0.32);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.dialogue-left .dialogue-bubble {
  background: rgba(0,217,255,0.1);
  border-color: rgba(0,217,255,0.2);
}

.dialogue-right .dialogue-bubble {
  background: rgba(220,141,168,0.1);
  border-color: rgba(220,141,168,0.2);
}

.dialogue-name {
  font-size: 22rpx;
  color: rgba(90,79,86,1.0);
  display: block;
  margin-bottom: 6rpx;
}

.dialogue-text {
  font-size: 26rpx;
  color: #5A4F56;
}

.dialogue-comment {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  text-align: center;
  font-style: italic;
}

/* ==================== 吵架TOP ==================== */
.conflict-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conflict-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(124,196,160,0.08);
  border-radius: 16rpx;
  padding: 20rpx;
}

.conflict-rank-1 {
  border: 1px solid rgba(255,215,0,0.3);
  background: rgba(255,215,0,0.05);
}

.conflict-rank-2 {
  border: 1px solid rgba(192,192,192,0.3);
  background: rgba(192,192,192,0.05);
}

.conflict-rank-3 {
  border: 1px solid rgba(205,127,50,0.3);
  background: rgba(205,127,50,0.05);
}

.conflict-rank {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
}

.rank-text {
  font-size: 20rpx;
  color: rgba(90,79,86,1.0);
}

.conflict-content {
  flex: 1;
}

.conflict-title {
  font-size: 28rpx;
  color: #5A4F56;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.conflict-desc {
  font-size: 22rpx;
  color: rgba(90,79,86,1.0);
}

/* ==================== 相处秘籍 ==================== */
.advice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  gap: 16rpx;
}

.advice-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #DC8DA8, #7CC4A0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.advice-content {
  flex: 1;
}

.advice-title {
  font-size: 28rpx;
  color: #5A4F56;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.advice-desc {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
}

/* ==================== 特殊提示 ==================== */
.special-hint-card {
  background: rgba(220,141,168,0.1);
  border-color: rgba(220,141,168,0.3);
}

.special-hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #DC8DA8;
  margin-bottom: 16rpx;
}

.special-hint-content {
  font-size: 28rpx;
  color: #5A4F56;
  margin-bottom: 20rpx;
}

.special-hint-tips {
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(90,79,86,1.0);
  margin-bottom: 10rpx;
}

.tip-dot {
  color: #DC8DA8;
}

.special-hint-ending {
  font-size: 24rpx;
  color: rgba(90,79,86,1.0);
  font-style: italic;
  text-align: center;
}

/* ==================== 分享文案 ==================== */
.moments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.moments-item {
  background: rgba(124,196,160,0.08);
  border-radius: 16rpx;
  padding: 20rpx;
  position: relative;
}

.moments-style {
  font-size: 22rpx;
  color: #DC8DA8;
  margin-bottom: 8rpx;
}

.moments-content {
  font-size: 26rpx;
  color: #5A4F56;
  line-height: 1.6;
}

.moments-copy {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #DC8DA8;
  padding: 8rpx 16rpx;
  background: rgba(0,217,255,0.1);
  border-radius: 12rpx;
}

/* ==================== 底部操作 ==================== */
.action-section {
  padding: 32rpx;
}

.btn-poster {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #DC8DA8, #7CC4A0) !important;
  border-radius: 50rpx;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #5A4F56 !important;
  margin-bottom: 20rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-poster::after {
  border: none;
}

.btn-poster text {
  color: #5A4F56;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.6) !important;
  border: 1px solid rgba(124,196,160,0.32) !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: rgba(90,79,86,1.0) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary text {
  color: rgba(90,79,86,1.0);
  font-size: 28rpx;
}

/* ==================== 免责声明 ==================== */
.disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  margin: 0 32rpx;
  background: rgba(124,196,160,0.08);
  border-radius: 16rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(90,79,86,1.0);
  line-height: 1.6;
}

.bottom-spacer {
  height: 80rpx;
}

/* ==================== 解锁区（场景1） ==================== */
.unlock-section {
  margin: 24rpx 32rpx;
  padding: 32rpx 28rpx;
  background: rgba(124,196,160,0.08);
  border: 1rpx solid rgba(124,196,160,0.32);
  border-radius: 24rpx;
}
.unlock-title {
  color: #5A4F56;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}
.unlock-desc {
  color: rgba(90,79,86,1.0);
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 深度内容预览（标题清单） */
.deep-preview {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(124,196,160,0.08);
  border: 1rpx solid rgba(124,196,160,0.32);
}
.deep-preview-item {
  color: rgba(90,79,86,1.0);
  font-size: 28rpx;
  line-height: 1.9;
  padding: 8rpx 0;
  border-bottom: 1rpx dashed rgba(124,196,160,0.32);
}
.deep-preview-item:last-child {
  border-bottom: none;
}

/* 已付费用户专属优惠提示 */
.vip-hint {
  background: linear-gradient(135deg, rgba(232,154,170, 0.2) 0%, rgba(240,203,138, 0.15) 100%);
  border: 1rpx solid rgba(232,154,170, 0.4);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}
.vip-hint-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}
.vip-hint-title {
  color: #5A4F56;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.vip-hint-desc {
  color: rgba(90,79,86,1.0);
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-line;
}
.vip-hint-highlight {
  color: #E8B878;
  font-weight: 600;
}

/* 解锁按钮组 */
.unlock-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 看广告按钮 */
.btn-ad {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 2rpx dashed rgba(124,196,160,0.32);
  border-radius: 20rpx;
  background: transparent;
}
.btn-ad-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(90,79,86,1.0);
  font-size: 28rpx;
}
.btn-ad-tag {
  background: rgba(34, 197, 94, 0.2);
  color: #22C55E;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}
.btn-ad-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--text-tertiary);
  border-right: 3rpx solid var(--text-tertiary);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 单次付费按钮 */
.btn-single {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border: 2rpx solid rgba(168, 85, 247, 0.5);
  border-radius: 20rpx;
  background: transparent;
}
.btn-single-title {
  color: #5A4F56;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-single-price {
  color: #C9A0C8;
  font-size: 32rpx;
  font-weight: 600;
}

/* 升级会员（专属版） */
.btn-vip-special {
  position: relative;
  padding: 28rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #E08A9A 0%, #E8B878 100%);
  box-shadow: 0 8rpx 32rpx rgba(232,154,170, 0.4);
  overflow: hidden;
}
.btn-vip-block {
  display: block;
  margin-bottom: 24rpx;
}
.btn-vip-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.8) 50%, transparent 60%);
  animation: shine 3s infinite;
  pointer-events: none;
}
@keyframes shine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
.btn-vip-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.btn-vip-left { flex: 1; }
.btn-vip-title {
  color: #5A4F56;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-vip-sub {
  color: rgba(90,79,86,1.0);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.btn-vip-price { text-align: right; }
.btn-vip-price-original {
  color: rgba(90,79,86,1.0);
  font-size: 22rpx;
  text-decoration: line-through;
}
.btn-vip-price-special {
  color: #5A4F56;
  font-size: 38rpx;
  font-weight: bold;
  margin-top: 4rpx;
}
.btn-vip-price-special text {
  font-size: 22rpx;
  font-weight: normal;
}
.exclusive-tag {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: linear-gradient(90deg, #E8B878, #E8B878);
  color: #000;
  font-size: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
  font-weight: 700;
  z-index: 2;
}

/* ==================== 场景2：底部常驻升级条 ==================== */
.sticky-upgrade {
  margin: 24rpx 32rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(90deg, rgba(232,154,170, 0.2), rgba(240,203,138, 0.2));
  border: 1rpx solid rgba(232,154,170, 0.3);
  border-radius: 20rpx;
}
.sticky-upgrade-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.sticky-upgrade-emoji { font-size: 32rpx; }
.sticky-upgrade-text {
  color: #5A4F56;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-line;
}
.sticky-upgrade-strong {
  color: #E8B878;
  font-weight: 600;
}
.sticky-upgrade-btn {
  background: linear-gradient(90deg, #E08A9A, #E8B878);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
}
.sticky-upgrade-close {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.sticky-upgrade-close .close-line {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  background: var(--text-secondary);
  border-radius: 1rpx;
}

.sticky-upgrade-close .close-line:nth-child(1) { transform: rotate(45deg); }
.sticky-upgrade-close .close-line:nth-child(2) { transform: rotate(-45deg); }

/* ==================== 弹窗 ==================== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(90,79,86,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal {
  width: 600rpx;
  background: linear-gradient(180deg, #E8F5EE 0%, rgba(90,79,86,0.85) 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  position: relative;
}
.modal-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.modal-close .close-line {
  position: absolute;
  width: 28rpx;
  height: 2rpx;
  background: var(--text-secondary);
  border-radius: 1rpx;
}

.modal-close .close-line:nth-child(1) { transform: rotate(45deg); }
.modal-close .close-line:nth-child(2) { transform: rotate(-45deg); }
.modal-title {
  text-align: center;
  color: #5A4F56;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.modal-highlight {
  background: linear-gradient(135deg, rgba(232,154,170, 0.2) 0%, rgba(240,203,138, 0.15) 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}
.modal-highlight-text {
  color: #5A4F56;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-line;
}
.modal-strong {
  color: #E8B878;
  font-weight: 700;
}
.modal-sub {
  color: rgba(90,79,86,1.0);
  font-size: 24rpx;
}
.modal-benefits {
  margin-bottom: 28rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: rgba(90,79,86,1.0);
  font-size: 28rpx;
  padding: 12rpx 0;
}
.benefit-check { color: #22C55E; }
.price-section {
  text-align: center;
  margin-bottom: 28rpx;
}
.price-compare {
  color: rgba(90,79,86,1.0);
  font-size: 26rpx;
  text-decoration: line-through;
  margin-bottom: 8rpx;
}
.price-main {
  color: #5A4F56;
  font-size: 60rpx;
  font-weight: bold;
  line-height: 1;
}
.price-unit {
  font-size: 26rpx;
  font-weight: normal;
  color: rgba(90,79,86,1.0);
}
.price-save {
  color: #22C55E;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.pay-buttons {
  display: flex;
  gap: 20rpx;
}
.pay-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.pay-btn-wechat {
  background: #07C160;
  color: #FFFFFF;
}
.pay-btn-single {
  background: rgba(168, 85, 247, 0.3);
  color: #5A4F56;
  border: 1rpx solid rgba(168, 85, 247, 0.5);
}
.pay-btn-ad {
  background: rgba(34, 197, 94, 0.3);
  color: #5A4F56;
  border: 1rpx solid rgba(34, 197, 94, 0.5);
}
.retest-pay { margin-top: 24rpx; }

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 8rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255,255,255,0.6);
}
.divider-text {
  color: rgba(90,79,86,1.0);
  font-size: 24rpx;
  padding: 0 24rpx;
}

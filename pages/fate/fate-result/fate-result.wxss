/* 结果页 - 深色渐变背景 */
.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* ==================== 顶部缘分卡片 ==================== */
.fate-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.fate-type-section {
  margin-bottom: 24rpx;
}

.fate-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}

.fate-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.fate-level {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 分数环 */
.score-ring-wrap {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3);
}

.score-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.score-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
}

/* 姓名组合 */
.names-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.name-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.zodiac-emoji {
  font-size: 28rpx;
}

.name-x {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin: 0 8rpx;
}

/* 金句 */
.tagline {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-style: italic;
  margin-bottom: 20rpx;
}

/* 话题标签 */
.hashtags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hashtag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* ==================== 通用卡片 ==================== */
.section-card {
  margin: 24rpx 32rpx;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-emoji {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.content-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.8;
}

/* ==================== 维度列表 ==================== */
.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dim-item {
  width: 100%;
}

.dim-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dim-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.dim-name {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  flex: 1;
}

.dim-score {
  font-size: 28rpx;
  font-weight: 700;
}

.dim-bar-bg {
  height: 10rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s ease;
}

.dim-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* ==================== 对话样式 ==================== */
.dialogue-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dialogue-line {
  display: flex;
}

.dialogue-left {
  justify-content: flex-start;
}

.dialogue-right {
  justify-content: flex-end;
}

.dialogue-bubble {
  max-width: 70%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.dialogue-left .dialogue-bubble {
  background: rgba(0,217,255,0.1);
  border-color: rgba(0,217,255,0.2);
}

.dialogue-right .dialogue-bubble {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.2);
}

.dialogue-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 6rpx;
}

.dialogue-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.dialogue-comment {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
  font-style: italic;
}

/* ==================== 吵架TOP ==================== */
.conflict-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conflict-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 20rpx;
}

.conflict-rank-1 {
  border: 1px solid rgba(255,215,0,0.3);
  background: rgba(255,215,0,0.05);
}

.conflict-rank-2 {
  border: 1px solid rgba(192,192,192,0.3);
  background: rgba(192,192,192,0.05);
}

.conflict-rank-3 {
  border: 1px solid rgba(205,127,50,0.3);
  background: rgba(205,127,50,0.05);
}

.conflict-rank {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
}

.rank-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}

.conflict-content {
  flex: 1;
}

.conflict-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.conflict-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* ==================== 相处秘籍 ==================== */
.advice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  gap: 16rpx;
}

.advice-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF006E);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.advice-content {
  flex: 1;
}

.advice-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.advice-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* ==================== 特殊提示 ==================== */
.special-hint-card {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.3);
}

.special-hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-bottom: 16rpx;
}

.special-hint-content {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.special-hint-tips {
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 10rpx;
}

.tip-dot {
  color: #FF6B35;
}

.special-hint-ending {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  font-style: italic;
  text-align: center;
}

/* ==================== 分享文案 ==================== */
.moments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.moments-item {
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  position: relative;
}

.moments-style {
  font-size: 22rpx;
  color: #FF6B35;
  margin-bottom: 8rpx;
}

.moments-content {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.moments-copy {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #00D9FF;
  padding: 8rpx 16rpx;
  background: rgba(0,217,255,0.1);
  border-radius: 12rpx;
}

/* ==================== 底部操作 ==================== */
.action-section {
  padding: 32rpx;
}

.btn-poster {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B35, #FF006E) !important;
  border-radius: 50rpx;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF !important;
  margin-bottom: 20rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-poster::after {
  border: none;
}

.btn-poster text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.2) !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary text {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
}

/* ==================== 免责声明 ==================== */
.disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  margin: 0 32rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

.bottom-spacer {
  height: 80rpx;
}

/* ==================== 解锁区（场景1） ==================== */
.unlock-section {
  margin: 24rpx 32rpx;
  padding: 32rpx 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
}
.unlock-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 12rpx;
}
.unlock-desc {
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

/* 深度内容预览（标题清单） */
.deep-preview {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.deep-preview-item {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  line-height: 1.9;
  padding: 8rpx 0;
  border-bottom: 1rpx dashed rgba(255, 255, 255, 0.06);
}
.deep-preview-item:last-child {
  border-bottom: none;
}

/* 已付费用户专属优惠提示 */
.vip-hint {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.2) 0%, rgba(255, 165, 0, 0.15) 100%);
  border: 1rpx solid rgba(255, 107, 107, 0.4);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}
.vip-hint-icon {
  font-size: 44rpx;
  margin-bottom: 12rpx;
}
.vip-hint-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.vip-hint-desc {
  color: rgba(255, 255, 255, 0.75);
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-line;
}
.vip-hint-highlight {
  color: #FFA500;
  font-weight: 600;
}

/* 解锁按钮组 */
.unlock-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 看广告按钮 */
.btn-ad {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  background: transparent;
}
.btn-ad-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 28rpx;
}
.btn-ad-tag {
  background: rgba(34, 197, 94, 0.2);
  color: #22C55E;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}
.btn-ad-arrow {
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

/* 单次付费按钮 */
.btn-single {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border: 2rpx solid rgba(168, 85, 247, 0.5);
  border-radius: 20rpx;
  background: transparent;
}
.btn-single-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}
.btn-single-price {
  color: #A855F7;
  font-size: 32rpx;
  font-weight: 600;
}

/* 升级会员（专属版） */
.btn-vip-special {
  position: relative;
  padding: 28rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FFA500 100%);
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.4);
  overflow: hidden;
}
.btn-vip-block {
  display: block;
  margin-bottom: 24rpx;
}
.btn-vip-shine {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.25) 50%, transparent 60%);
  animation: shine 3s infinite;
  pointer-events: none;
}
@keyframes shine {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
.btn-vip-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.btn-vip-left { flex: 1; }
.btn-vip-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-vip-sub {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.btn-vip-price { text-align: right; }
.btn-vip-price-original {
  color: rgba(255, 255, 255, 0.65);
  font-size: 22rpx;
  text-decoration: line-through;
}
.btn-vip-price-special {
  color: #fff;
  font-size: 38rpx;
  font-weight: bold;
  margin-top: 4rpx;
}
.btn-vip-price-special text {
  font-size: 22rpx;
  font-weight: normal;
}
.exclusive-tag {
  position: absolute;
  top: -12rpx;
  right: 24rpx;
  background: linear-gradient(90deg, #FFD700, #FFA500);
  color: #000;
  font-size: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
  font-weight: 700;
  z-index: 2;
}

/* ==================== 场景2：底部常驻升级条 ==================== */
.sticky-upgrade {
  margin: 24rpx 32rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.2), rgba(255, 165, 0, 0.2));
  border: 1rpx solid rgba(255, 107, 107, 0.3);
  border-radius: 20rpx;
}
.sticky-upgrade-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.sticky-upgrade-emoji { font-size: 32rpx; }
.sticky-upgrade-text {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-line;
}
.sticky-upgrade-strong {
  color: #FFA500;
  font-weight: 600;
}
.sticky-upgrade-btn {
  background: linear-gradient(90deg, #FF6B6B, #FFA500);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
}
.sticky-upgrade-close {
  color: rgba(255, 255, 255, 0.4);
  font-size: 32rpx;
  padding: 0 8rpx;
}

/* ==================== 弹窗 ==================== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}
.modal {
  width: 600rpx;
  background: linear-gradient(180deg, #1A1A2E 0%, #0F0F1A 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  position: relative;
}
.modal-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 40rpx;
  line-height: 1;
}
.modal-title {
  text-align: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}
.modal-highlight {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.2) 0%, rgba(255, 165, 0, 0.15) 100%);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  text-align: center;
}
.modal-highlight-text {
  color: #fff;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-line;
}
.modal-strong {
  color: #FFA500;
  font-weight: 700;
}
.modal-sub {
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
}
.modal-benefits {
  margin-bottom: 28rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  padding: 12rpx 0;
}
.benefit-check { color: #22C55E; }
.price-section {
  text-align: center;
  margin-bottom: 28rpx;
}
.price-compare {
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
  text-decoration: line-through;
  margin-bottom: 8rpx;
}
.price-main {
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
  line-height: 1;
}
.price-unit {
  font-size: 26rpx;
  font-weight: normal;
  color: rgba(255, 255, 255, 0.6);
}
.price-save {
  color: #22C55E;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.pay-buttons {
  display: flex;
  gap: 20rpx;
}
.pay-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.pay-btn-wechat {
  background: #07C160;
  color: #fff;
}
.pay-btn-douyin {
  background: #000;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}
.pay-btn-single {
  background: rgba(168, 85, 247, 0.3);
  color: #fff;
  border: 1rpx solid rgba(168, 85, 247, 0.5);
}
.pay-btn-ad {
  background: rgba(34, 197, 94, 0.3);
  color: #fff;
  border: 1rpx solid rgba(34, 197, 94, 0.5);
}
.retest-pay { margin-top: 24rpx; }

.divider {
  display: flex;
  align-items: center;
  margin: 32rpx 0 8rpx;
}
.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
}
.divider-text {
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
  padding: 0 24rpx;
}

/* 结果页 - 深色渐变背景 */
.result-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
}

/* ==================== 顶部缘分卡片 ==================== */
.fate-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  pointer-events: none;
}

.fate-type-section {
  margin-bottom: 24rpx;
}

.fate-emoji {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}

.fate-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.fate-level {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 分数环 */
.score-ring-wrap {
  display: flex;
  justify-content: center;
  margin: 32rpx 0;
}

.score-ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.3);
}

.score-inner {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.score-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
}

/* 姓名组合 */
.names-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.name-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.zodiac-emoji {
  font-size: 28rpx;
}

.name-x {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  margin: 0 8rpx;
}

/* 金句 */
.tagline {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-style: italic;
  margin-bottom: 20rpx;
}

/* 话题标签 */
.hashtags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hashtag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* ==================== 通用卡片 ==================== */
.section-card {
  margin: 24rpx 32rpx;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-emoji {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.content-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.8;
}

/* ==================== 维度列表 ==================== */
.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.dim-item {
  width: 100%;
}

.dim-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.dim-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.dim-name {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  flex: 1;
}

.dim-score {
  font-size: 28rpx;
  font-weight: 700;
}

.dim-bar-bg {
  height: 10rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 5rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dim-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.8s ease;
}

.dim-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}

/* ==================== 对话样式 ==================== */
.dialogue-box {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dialogue-line {
  display: flex;
}

.dialogue-left {
  justify-content: flex-start;
}

.dialogue-right {
  justify-content: flex-end;
}

.dialogue-bubble {
  max-width: 70%;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 16rpx 24rpx;
}

.dialogue-left .dialogue-bubble {
  background: rgba(0,217,255,0.1);
  border-color: rgba(0,217,255,0.2);
}

.dialogue-right .dialogue-bubble {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.2);
}

.dialogue-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 6rpx;
}

.dialogue-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.dialogue-comment {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
  font-style: italic;
}

/* ==================== 吵架TOP ==================== */
.conflict-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.conflict-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 20rpx;
}

.conflict-rank-1 {
  border: 1px solid rgba(255,215,0,0.3);
  background: rgba(255,215,0,0.05);
}

.conflict-rank-2 {
  border: 1px solid rgba(192,192,192,0.3);
  background: rgba(192,192,192,0.05);
}

.conflict-rank-3 {
  border: 1px solid rgba(205,127,50,0.3);
  background: rgba(205,127,50,0.05);
}

.conflict-rank {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 28rpx;
}

.rank-text {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
}

.conflict-content {
  flex: 1;
}

.conflict-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.conflict-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

/* ==================== 相处秘籍 ==================== */
.advice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advice-item {
  display: flex;
  gap: 16rpx;
}

.advice-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FF006E);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.advice-content {
  flex: 1;
}

.advice-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.advice-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* ==================== 特殊提示 ==================== */
.special-hint-card {
  background: rgba(255,107,53,0.1);
  border-color: rgba(255,107,53,0.3);
}

.special-hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-bottom: 16rpx;
}

.special-hint-content {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.special-hint-tips {
  margin-bottom: 20rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 10rpx;
}

.tip-dot {
  color: #FF6B35;
}

.special-hint-ending {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  font-style: italic;
  text-align: center;
}

/* ==================== 分享文案 ==================== */
.moments-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.moments-item {
  background: rgba(255,255,255,0.05);
  border-radius: 16rpx;
  padding: 20rpx;
  position: relative;
}

.moments-style {
  font-size: 22rpx;
  color: #FF6B35;
  margin-bottom: 8rpx;
}

.moments-content {
  font-size: 26rpx;
  color: #FFFFFF;
  line-height: 1.6;
}

.moments-copy {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  color: #00D9FF;
  padding: 8rpx 16rpx;
  background: rgba(0,217,255,0.1);
  border-radius: 12rpx;
}

/* ==================== 底部操作 ==================== */
.action-section {
  padding: 32rpx;
}

.btn-poster {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B35, #FF006E) !important;
  border-radius: 50rpx;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF !important;
  margin-bottom: 20rpx;
  padding: 0;
  line-height: 1.4;
}

.btn-poster::after {
  border: none;
}

.btn-poster text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.2) !important;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  line-height: 1.4;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary text {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
}

/* ==================== 免责声明 ==================== */
.disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  margin: 0 32rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

.bottom-spacer {
  height: 80rpx;
}

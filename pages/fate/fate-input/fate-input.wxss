/* 页面背景 */
.page-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #0F0C29 0%, #302B63 50%, #24243E 100%);
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* ==================== 进度条 ==================== */
.progress-bar {
  padding: 24rpx 0 16rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.progress-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}

.progress-track {
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35, #FF006E);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* ==================== 卡片 ==================== */
.section-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

/* ==================== 输入框 ==================== */
.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #FF6B35;
}

.input-field {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  line-height: 88rpx;
}

.input-field:focus {
  border-color: #FF6B35;
}

.input-placeholder {
  color: rgba(255,255,255,0.3);
}

.picker-field {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  color: rgba(255,255,255,0.3);
  font-size: 28rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  box-sizing: border-box;
}

.picker-field::after {
  content: '›';
  font-size: 32rpx;
  color: rgba(255,255,255,0.3);
  margin-left: 16rpx;
}

.picker-field.has-value {
  color: #FFFFFF;
}

.picker-field.has-value::after {
  color: rgba(255,255,255,0.5);
}

/* 时长选择器 */
.duration-picker {
  text-align: center;
  justify-content: center;
  flex: 1;
}

.duration-picker::after {
  content: '';
  display: none;
}

/* ==================== 星座信息 ==================== */
.zodiac-info {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.zodiac-tag {
  background: rgba(255,107,53,0.15);
  border: 1px solid rgba(255,107,53,0.3);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #FF6B35;
}

.zodiac-tag.life-path {
  background: rgba(255,0,110,0.15);
  border-color: rgba(255,0,110,0.3);
  color: #FF006E;
}

/* ==================== 初步预测卡 ==================== */
.preview-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,107,53,0.3);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.preview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-bottom: 20rpx;
}

.preview-zodiac-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.preview-zodiac {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.preview-x {
  font-size: 28rpx;
  color: rgba(255,255,255,0.4);
}

.preview-element {
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FF6B35, #FF006E);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 12rpx;
}

.preview-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.preview-range {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.highlight {
  color: #FF6B35;
  font-weight: 600;
  font-size: 30rpx;
}

/* ==================== 按钮 ==================== */
.btn-area {
  padding: 24rpx 0;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #FF6B35, #FF006E) !important;
  color: #FFFFFF !important;
  border: none !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.btn-secondary {
  flex: 0.6;
  background: transparent !important;
  color: rgba(255,255,255,0.7) !important;
  border: 1px solid rgba(255,255,255,0.2) !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary text {
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
}

/* ==================== 关系状态网格 ==================== */
.relation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.relation-item {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.relation-item.selected {
  background: rgba(255,107,53,0.1);
  border-color: #FF6B35;
  box-shadow: 0 0 20rpx rgba(255,107,53,0.2);
}

.relation-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.relation-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.relation-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
}

/* ==================== 情感反馈卡 ==================== */
.feedback-card {
  background: rgba(255,107,53,0.15);
  border: 1px solid rgba(255,107,53,0.25);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.feedback-title {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.feedback-quote {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  font-style: italic;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.feedback-hint {
  font-size: 24rpx;
  color: #FF6B35;
}

/* ==================== 额外字段 ==================== */
.extra-fields {
  margin-bottom: 24rpx;
}

.extra-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 16rpx;
}

.duration-row {
  display: flex;
  gap: 20rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.option-item.option-selected {
  background: rgba(255,107,53,0.15);
  border-color: #FF6B35;
  color: #FF6B35;
}

/* ==================== 故事输入 ==================== */
.story-textarea {
  width: 100%;
  height: 200rpx;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.story-count {
  text-align: right;
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
}

/* ==================== 确认页 ==================== */
.confirm-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}

.confirm-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.confirm-value {
  font-size: 26rpx;
  color: #FFFFFF;
  text-align: right;
  max-width: 60%;
}

.confirm-value.story-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
}

.confirm-divider {
  height: 1px;
  background: rgba(255,255,255,0.08);
  margin: 12rpx 0;
}

/* ==================== 免责声明 ==================== */
.disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  line-height: 1.6;
}

/* ==================== 底部安全区 ==================== */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  padding-bottom: 40rpx;
}

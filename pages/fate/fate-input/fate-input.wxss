/* ==================== 页面基础 ==================== */
.page-bg {
  min-height: 100vh;
  background: #FFF8F8;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ==================== 进度条 ==================== */
.progress-bar {
  padding: 24rpx 0 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #756A72;
}

.progress-label {
  font-size: 24rpx;
  color: #A99FA5;
}

.progress-track {
  height: 8rpx;
  background: #F2E8EA;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #F47C8E;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* ==================== 卡片 ==================== */
.section-card {
  background: #FFFFFF;
  border: 1px solid #F0E4E7;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(113, 73, 85, 0.08);
}

.section-card.me-card {
  border-top: 6rpx solid #FFD9DF;
}

.section-card.ta-card {
  border-top: 6rpx solid #DDF3EC;
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.avatar-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.avatar-badge.me {
  color: #E96379;
  background: #FFF1F3;
}

.avatar-badge.ta {
  color: #438F7A;
  background: #EFF9F5;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #382F36;
}

/* ==================== 输入框 ==================== */
.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #382F36;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #F47C8E;
}

.helper-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A99FA5;
}

.input-field {
  background: #FFFDFD;
  border: 1px solid #F0E4E7;
  border-radius: 20rpx;
  padding: 0 24rpx;
  color: #382F36;
  font-size: 30rpx;
  width: 100%;
  height: 96rpx;
  box-sizing: border-box;
  line-height: 96rpx;
}

.input-placeholder {
  color: #B8AFB4;
}

.picker-field {
  background: #FFFDFD;
  border: 1px solid #F0E4E7;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #B8AFB4;
  font-size: 30rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  box-sizing: border-box;
}

.picker-field::after {
  content: '›';
  font-size: 32rpx;
  color: #A99FA5;
  margin-left: 16rpx;
}

.picker-field.has-value {
  color: #382F36;
}

.picker-field.has-value::after {
  color: #A99FA5;
}

/* 时长选择器 */
.duration-picker {
  text-align: center;
  justify-content: center;
  flex: 1;
}

.duration-picker::after {
  content: '';
  display: none;
}

/* ==================== 按钮 ==================== */
.btn-area {
  padding: 24rpx 0;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-primary {
  flex: 1;
  background: linear-gradient(135deg, #F58A99 0%, #EF6F83 100%) !important;
  color: #FFFFFF !important;
  border: none !important;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  box-shadow: 0 12rpx 28rpx rgba(239, 111, 131, 0.24);
}

.btn-primary::after {
  border: none;
}

.btn-disabled {
  background: #E9DEE1 !important;
  color: #B8AEB3 !important;
  box-shadow: none;
  pointer-events: none;
}

.btn-secondary {
  flex: 0.6;
  background: #FFFFFF !important;
  color: #756A72 !important;
  border: 1px solid #F0E4E7 !important;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.btn-secondary::after {
  border: none;
}

/* ==================== 关系状态网格 ==================== */
.relation-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.relation-item {
  background: #FFFDFD;
  border: 1px solid #F0E4E7;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.relation-item.selected {
  background: #FFF1F3;
  border-color: #F47C8E;
  box-shadow: 0 8rpx 20rpx rgba(244, 124, 142, 0.18);
}

.relation-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.relation-label {
  font-size: 28rpx;
  color: #382F36;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.relation-desc {
  font-size: 22rpx;
  color: #A99FA5;
}

/* ==================== 情感反馈卡 ==================== */
.feedback-card {
  background: #FFF1F3;
  border: 1px solid #FFD9DF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.feedback-title {
  font-size: 30rpx;
  color: #382F36;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.feedback-quote {
  font-size: 24rpx;
  color: #756A72;
  font-style: italic;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.feedback-hint {
  font-size: 24rpx;
  color: #E96379;
}

/* ==================== 额外字段 ==================== */
.extra-fields {
  margin-bottom: 24rpx;
}

.extra-title {
  font-size: 26rpx;
  color: #382F36;
  margin-bottom: 16rpx;
}

.duration-row {
  display: flex;
  gap: 20rpx;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  background: #FFFDFD;
  border: 1px solid #F0E4E7;
  border-radius: 16rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
  color: #756A72;
}

.option-item.option-selected {
  background: #FFF1F3;
  border-color: #F47C8E;
  color: #E96379;
}

/* ==================== 故事输入 ==================== */
.story-textarea {
  width: 100%;
  height: 200rpx;
  background: #FFFDFD;
  border: 1px solid #F0E4E7;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  color: #382F36;
  font-size: 26rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.story-count {
  text-align: right;
  font-size: 22rpx;
  color: #A99FA5;
  margin-top: 8rpx;
}

/* ==================== 信息预览 ==================== */
.confirm-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}

.confirm-label {
  font-size: 26rpx;
  color: #756A72;
  flex-shrink: 0;
}

.confirm-value {
  font-size: 26rpx;
  color: #382F36;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
}

.confirm-value.story-text {
  font-size: 24rpx;
  color: #756A72;
  font-weight: 400;
  line-height: 1.6;
}

.confirm-divider {
  height: 1px;
  background: #F0E4E7;
  margin: 12rpx 0;
}

/* ==================== 温馨提示 ==================== */
.disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #EFF9F5;
  border: 1px solid #DDF3EC;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.disclaimer-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #756A72;
  line-height: 1.6;
}

/* ==================== 底部安全区 ==================== */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  padding-bottom: 40rpx;
}

/* ==================== 公历/农历切换 ==================== */
.calendar-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 6rpx;
  background: #F8F2F4;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.calendar-tab {
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #A99FA5;
  background: transparent;
  border-radius: 12rpx;
  transition: all 0.2s;
}
.calendar-tab.active {
  color: #E96379;
  background: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(105, 73, 83, 0.08);
}

/* ==================== 农历选择器弹窗 ==================== */
.lunar-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(56, 47, 54, 0.45);
  z-index: 999;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.25s;
}
.lunar-mask.show {
  visibility: visible;
  opacity: 1;
}
.lunar-modal {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.25s;
}
.lunar-mask.show .lunar-modal {
  transform: translateY(0);
}
.lunar-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1px solid #F0E4E7;
}
.lunar-cancel {
  font-size: 30rpx;
  color: #756A72;
  padding: 8rpx 12rpx;
}
.lunar-title {
  font-size: 32rpx;
  color: #382F36;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.lunar-confirm {
  font-size: 30rpx;
  color: #F47C8E;
  font-weight: 600;
  padding: 8rpx 12rpx;
}
.lunar-pickers {
  padding: 24rpx 0 32rpx;
}
.lunar-picker-view {
  width: 100%;
  height: 440rpx;
}
.lunar-col-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  color: #382F36;
}
.lunar-indicator {
  height: 80rpx;
  background: #FFF1F3;
  border-top: 1px solid #FFD9DF;
  border-bottom: 1px solid #FFD9DF;
}

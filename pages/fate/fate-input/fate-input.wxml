<view class="page-bg">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-info">
      <text class="progress-text">步骤 {{step}}/3</text>
      <text class="progress-label" wx:if="{{step===1}}">基本信息</text>
      <text class="progress-label" wx:if="{{step===2}}">关系状态</text>
      <text class="progress-label" wx:if="{{step===3}}">确认信息</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressWidth}}%"></view>
    </view>
  </view>

  <!-- ==================== 步骤1：基本信息 ==================== -->
  <view class="step-container" wx:if="{{step===1}}">
    <!-- 你的信息 -->
    <view class="section-card">
      <view class="section-title">🧑 你的信息</view>

      <view class="input-group">
        <text class="input-label">你的姓名 <text class="required">*</text></text>
        <input class="input-field" placeholder="请输入你的姓名" placeholder-class="input-placeholder"
          value="{{personA.name}}" bindinput="onNameInput" data-who="personA" maxlength="10" />
      </view>

      <view class="input-group">
        <text class="input-label">你的生日 <text class="required">*</text></text>
        <view class="calendar-tabs">
          <view class="calendar-tab {{personA.calendarType === 'solar' ? 'active' : ''}}"
            data-who="personA" data-type="solar" bindtap="switchCalendarType">阳历</view>
          <view class="calendar-tab {{personA.calendarType === 'lunar' ? 'active' : ''}}"
            data-who="personA" data-type="lunar" bindtap="switchCalendarType">农历</view>
        </view>
        <picker wx:if="{{personA.calendarType === 'solar'}}" mode="date" value="{{personA.birthday}}" end="{{today}}" bindchange="onBirthdayChange" data-who="personA">
          <view class="picker-field {{personA.birthday ? 'has-value' : ''}}">
            {{personA.birthday || '请选择你的生日'}}
          </view>
        </picker>
        <view wx:else class="picker-field {{personA.birthdayLunar ? 'has-value' : ''}}"
          data-who="personA" bindtap="openLunarPicker">
          {{personA.birthdayLunar || '请选择农历生日'}}
        </view>
      </view>

      <!-- 星座+灵数 -->
      <view class="zodiac-info" wx:if="{{personA.zodiac}}">
        <view class="zodiac-tag">{{personA.zodiac.emoji}} {{personA.zodiac.name}}</view>
        <view class="zodiac-tag life-path">🔮 生命灵数 {{personA.lifePath}}</view>
      </view>
    </view>

    <!-- TA的信息 -->
    <view class="section-card">
      <view class="section-title">💫 TA的信息</view>

      <view class="input-group">
        <text class="input-label">TA的姓名 <text class="required">*</text></text>
        <input class="input-field" placeholder="请输入TA的姓名" placeholder-class="input-placeholder"
          value="{{personB.name}}" bindinput="onNameInput" data-who="personB" maxlength="10" />
      </view>

      <view class="input-group">
        <text class="input-label">TA的生日 <text class="required">*</text></text>
        <view class="calendar-tabs">
          <view class="calendar-tab {{personB.calendarType === 'solar' ? 'active' : ''}}"
            data-who="personB" data-type="solar" bindtap="switchCalendarType">阳历</view>
          <view class="calendar-tab {{personB.calendarType === 'lunar' ? 'active' : ''}}"
            data-who="personB" data-type="lunar" bindtap="switchCalendarType">农历</view>
        </view>
        <picker wx:if="{{personB.calendarType === 'solar'}}" mode="date" value="{{personB.birthday}}" end="{{today}}" bindchange="onBirthdayChange" data-who="personB">
          <view class="picker-field {{personB.birthday ? 'has-value' : ''}}">
            {{personB.birthday || '请选择TA的生日'}}
          </view>
        </picker>
        <view wx:else class="picker-field {{personB.birthdayLunar ? 'has-value' : ''}}"
          data-who="personB" bindtap="openLunarPicker">
          {{personB.birthdayLunar || '请选择农历生日'}}
        </view>
      </view>

      <view class="zodiac-info" wx:if="{{personB.zodiac}}">
        <view class="zodiac-tag">{{personB.zodiac.emoji}} {{personB.zodiac.name}}</view>
        <view class="zodiac-tag life-path">🔮 生命灵数 {{personB.lifePath}}</view>
      </view>
    </view>

    <!-- 初步预测卡 -->
    <view class="preview-card" wx:if="{{previewVisible && preview}}">
      <view class="preview-title">✨ 初步预测</view>
      <view class="preview-zodiac-row">
        <view class="preview-zodiac">{{preview.zodiacA.emoji}} {{preview.zodiacA.name}}</view>
        <view class="preview-x">×</view>
        <view class="preview-zodiac">{{preview.zodiacB.emoji}} {{preview.zodiacB.name}}</view>
      </view>
      <view class="preview-element">{{preview.elementCombo}}</view>
      <view class="preview-desc">{{preview.elementDesc}}</view>
      <view class="preview-range">预测缘分范围：<text class="highlight">{{preview.predictRange}}</text></view>
    </view>

    <!-- 下一步按钮 -->
    <view class="btn-area">
      <button class="btn-primary {{personA.name && personA.birthday && personB.name && personB.birthday ? '' : 'btn-disabled'}}"
        bindtap="goStep2">下一步：关系状态</button>
    </view>
  </view>

  <!-- ==================== 步骤2：关系状态 ==================== -->
  <view class="step-container" wx:if="{{step===2}}">
    <view class="section-card">
      <view class="section-title">💑 你们的关系</view>

      <!-- 关系状态网格 -->
      <view class="relation-grid">
        <view class="relation-item {{selectedRelation === item.value ? 'selected' : ''}}"
          wx:for="{{relationshipList}}" wx:key="value"
          data-value="{{item.value}}" bindtap="selectRelation">
          <view class="relation-emoji">{{item.emoji}}</view>
          <view class="relation-label">{{item.label}}</view>
          <view class="relation-desc">{{item.desc}}</view>
        </view>
      </view>

      <!-- 情感反馈卡 -->
      <view class="feedback-card" wx:if="{{relationFeedback}}">
        <view class="feedback-title">{{relationFeedback.title}}</view>
        <view class="feedback-quote">{{relationFeedback.quote}}</view>
        <view class="feedback-hint">{{relationFeedback.hint}}</view>
      </view>

      <!-- 在一起/已婚 时长选择 -->
      <view class="extra-fields" wx:if="{{showDuration}}">
        <view class="extra-title">在一起多久了？</view>
        <view class="duration-row">
          <picker mode="selector" range="{{yearRange}}" value="{{durationYears}}" bindchange="onDurationYearsChange">
            <view class="picker-field duration-picker {{durationYears !== '' ? 'has-value' : ''}}">{{durationYears !== '' ? durationYears + ' 年' : '选择年'}}</view>
          </picker>
          <picker mode="selector" range="{{monthRange}}" value="{{durationMonths}}" bindchange="onDurationMonthsChange">
            <view class="picker-field duration-picker {{durationMonths !== '' ? 'has-value' : ''}}">{{durationMonths !== '' ? durationMonths + ' 个月' : '选择月'}}</view>
          </picker>
        </view>
      </view>

      <!-- 分手后额外字段 -->
      <view class="extra-fields" wx:if="{{showBreakup}}">
        <view class="extra-title">分手多久了？</view>
        <view class="option-list">
          <view class="option-item {{breakupDuration === '1month' ? 'option-selected' : ''}}"
            data-value="1month" bindtap="selectBreakupDuration">1个月以内</view>
          <view class="option-item {{breakupDuration === '1-3month' ? 'option-selected' : ''}}"
            data-value="1-3month" bindtap="selectBreakupDuration">1-3个月</view>
          <view class="option-item {{breakupDuration === '3-6month' ? 'option-selected' : ''}}"
            data-value="3-6month" bindtap="selectBreakupDuration">3-6个月</view>
          <view class="option-item {{breakupDuration === '6month+' ? 'option-selected' : ''}}"
            data-value="6month+" bindtap="selectBreakupDuration">6个月以上</view>
        </view>

        <view class="extra-title" style="margin-top: 24rpx;">你想？</view>
        <view class="option-list">
          <view class="option-item {{breakupIntention === 'reunion' ? 'option-selected' : ''}}"
            data-value="reunion" bindtap="selectBreakupIntention">复合</view>
          <view class="option-item {{breakupIntention === 'letgo' ? 'option-selected' : ''}}"
            data-value="letgo" bindtap="selectBreakupIntention">放下</view>
          <view class="option-item {{breakupIntention === 'unsure' ? 'option-selected' : ''}}"
            data-value="unsure" bindtap="selectBreakupIntention">不知道</view>
        </view>
      </view>
    </view>

    <!-- 你们的故事 -->
    <view class="section-card">
      <view class="section-title">📖 你们的故事（选填）</view>
      <textarea class="story-textarea" placeholder="写下你们的故事，让测算更精准..."
        placeholder-class="input-placeholder" maxlength="200"
        value="{{story}}" bindinput="onStoryInput"></textarea>
      <view class="story-count">{{storyLength}}/200</view>
    </view>

    <!-- 按钮区 -->
    <view class="btn-area btn-row">
      <button class="btn-secondary" bindtap="goBack">上一步</button>
      <button class="btn-primary {{selectedRelation ? '' : 'btn-disabled'}}" bindtap="goStep3">开始测算</button>
    </view>
  </view>

  <!-- ==================== 步骤3：确认信息 ==================== -->
  <view class="step-container" wx:if="{{step===3 && confirmData}}">
    <view class="section-card">
      <view class="section-title">📋 信息确认</view>

      <view class="confirm-row">
        <text class="confirm-label">你的姓名</text>
        <text class="confirm-value">{{confirmData.personA.name}}</text>
      </view>
      <view class="confirm-row">
        <text class="confirm-label">你的生日</text>
        <text class="confirm-value">{{confirmData.personA.birthday}} {{confirmData.personA.zodiac.emoji}}{{confirmData.personA.zodiac.name}}</text>
      </view>
      <view class="confirm-row">
        <text class="confirm-label">生命灵数</text>
        <text class="confirm-value">{{confirmData.personA.lifePath}}</text>
      </view>

      <view class="confirm-divider"></view>

      <view class="confirm-row">
        <text class="confirm-label">TA的姓名</text>
        <text class="confirm-value">{{confirmData.personB.name}}</text>
      </view>
      <view class="confirm-row">
        <text class="confirm-label">TA的生日</text>
        <text class="confirm-value">{{confirmData.personB.birthday}} {{confirmData.personB.zodiac.emoji}}{{confirmData.personB.zodiac.name}}</text>
      </view>
      <view class="confirm-row">
        <text class="confirm-label">生命灵数</text>
        <text class="confirm-value">{{confirmData.personB.lifePath}}</text>
      </view>

      <view class="confirm-divider"></view>

      <view class="confirm-row">
        <text class="confirm-label">关系状态</text>
        <text class="confirm-value">{{confirmData.relation.emoji}} {{confirmData.relation.label}}</text>
      </view>

      <view class="confirm-row" wx:if="{{confirmData.durationYears !== '' || confirmData.durationMonths !== ''}}">
        <text class="confirm-label">在一起时长</text>
        <text class="confirm-value">{{confirmData.durationYears || 0}}年{{confirmData.durationMonths || 0}}个月</text>
      </view>

      <view class="confirm-row" wx:if="{{confirmData.breakupDuration}}">
        <text class="confirm-label">分手时长</text>
        <text class="confirm-value">{{confirmData.breakupDuration}}</text>
      </view>
      <view class="confirm-row" wx:if="{{confirmData.breakupIntention}}">
        <text class="confirm-label">你的想法</text>
        <text class="confirm-value">{{confirmData.breakupIntention === 'reunion' ? '复合' : confirmData.breakupIntention === 'letgo' ? '放下' : '不知道'}}</text>
      </view>

      <view class="confirm-row" wx:if="{{confirmData.story}}">
        <text class="confirm-label">你们的故事</text>
        <text class="confirm-value story-text">{{confirmData.story}}</text>
      </view>
    </view>

    <!-- 初步预测分析卡 -->
    <view class="preview-card" wx:if="{{confirmData.preview}}">
      <view class="preview-title">🔮 初步预测分析</view>
      <view class="preview-zodiac-row">
        <view class="preview-zodiac">{{confirmData.preview.zodiacA.emoji}} {{confirmData.preview.zodiacA.name}}</view>
        <view class="preview-x">×</view>
        <view class="preview-zodiac">{{confirmData.preview.zodiacB.emoji}} {{confirmData.preview.zodiacB.name}}</view>
      </view>
      <view class="preview-element">{{confirmData.preview.elementCombo}}</view>
      <view class="preview-desc">{{confirmData.preview.elementDesc}}</view>
      <view class="preview-range">预测缘分范围：<text class="highlight">{{confirmData.preview.predictRange}}</text></view>
    </view>

    <!-- 仅供娱乐提示 -->
    <view class="disclaimer">
      <text class="disclaimer-icon">🎭</text>
      <text class="disclaimer-text">本测试仅供娱乐参考，不代表真实感情状况。真正的缘分需要双方用心经营~</text>
    </view>

    <!-- 按钮区 -->
    <view class="btn-area btn-row">
      <button class="btn-secondary" bindtap="goBack">返回修改</button>
      <button class="btn-primary" bindtap="confirmSubmit">确认开始测算 ✨</button>
    </view>
  </view>

  <!-- ==================== 农历选择器弹窗 ==================== -->
  <view class="lunar-mask {{lunarPickerVisible ? 'show' : ''}}" bindtap="closeLunarPicker" catchtouchmove="noop">
    <view class="lunar-modal" catchtap="noop">
      <view class="lunar-modal-header">
        <text class="lunar-cancel" bindtap="closeLunarPicker">取消</text>
        <text class="lunar-title">选择农历生日</text>
        <text class="lunar-confirm" bindtap="confirmLunarPicker">确定</text>
      </view>
      <view class="lunar-pickers">
        <picker-view class="lunar-picker-view" indicator-class="lunar-indicator"
          value="{{[lunarYearIndex, lunarMonthIndex, lunarDayIndex]}}"
          bindchange="onLunarPickerChange">
          <picker-view-column>
            <view class="lunar-col-item" wx:for="{{lunarYearRange}}" wx:key="*this">{{item}}</view>
          </picker-view-column>
          <picker-view-column>
            <view class="lunar-col-item" wx:for="{{lunarMonthRange}}" wx:key="*this">{{item}}</view>
          </picker-view-column>
          <picker-view-column>
            <view class="lunar-col-item" wx:for="{{lunarDayRange}}" wx:key="*this">{{item}}</view>
          </picker-view-column>
        </picker-view>
      </view>
    </view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>

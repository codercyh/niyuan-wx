/* ==================== 全局样式 - 梦幻渐变浅色主题 ==================== */

page {
  margin: 0;
  padding: 0;
  box-sizing: border-box;

  /* 主色调 - 柔粉配薄荷绿(水彩渐变,加深版) */
  --primary-color: #DC8DA8;
  --primary-light: #DC8DA8;
  --primary-dark: #C9788F;
  --primary-bg: rgba(220,141,168,0.14);
  --accent-color: #7CC4A0;
  --accent-light: #A8D8C0;
  --accent-bg: rgba(124,196,160,0.14);

  /* 渐变色 */
  --gradient-primary: linear-gradient(135deg, #E89AB2 0%, #7CC4A0 100%);
  --gradient-bg: linear-gradient(135deg, #FCE8E8 0%, #FFF0E8 40%, #E8F5EE 100%);
  --gradient-card: linear-gradient(135deg, rgba(255,255,255,0.88) 0%, rgba(255,255,255,0.7) 100%);
  --gradient-button: linear-gradient(135deg, #E89AB2 0%, #7CC4A0 100%);

  /* 背景色 - 浅色系 */
  --bg-page: #FCEEEE;
  --bg-light: rgba(124,196,160,0.06);
  --bg-card: rgba(255,255,255,0.82);
  --bg-card-hover: rgba(255,255,255,0.92);
  --bg-input: rgba(255,255,255,0.85);
  --bg-mask: rgba(110, 100, 100, 0.45);

  /* 文字颜色 */
  --text-primary: #5A4F56;
  --text-secondary: rgba(90,79,86,0.6);
  --text-tertiary: rgba(90,79,86,0.4);
  --text-placeholder: rgba(90,79,86,0.3);
  --text-white: #FFFFFF;

  /* 边框颜色 */
  --border-color: rgba(124,196,160,0.14);
  --border-light: rgba(124,196,160,0.07);
  --border-active: rgba(220,141,168,0.45);

  /* 辅助色 */
  --success-color: #7CC4A0;
  --warning-color: #E8B878;
  --danger-color: #E08A9A;
  --info-color: #98B8D8;

  /* 阴影 */
  --shadow-sm: 0 2px 8px rgba(124,196,160,0.08);
  --shadow-md: 0 4px 16px rgba(124,196,160,0.1);
  --shadow-lg: 0 8px 32px rgba(124,196,160,0.12);
  --shadow-primary: 0 4px 20px rgba(220,141,168,0.18);
  --shadow-glow: 0 0 20px rgba(220,141,168,0.22);

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-full: 9999rpx;

  background: var(--gradient-bg);
  background-attachment: fixed;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ==================== 通用布局 ==================== */

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--gradient-bg);
  background-attachment: fixed;
}

.page-scroll {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 32rpx;
}

.container-large {
  padding: 40rpx;
}

/* ==================== 文本样式 ==================== */

.text-primary {
  color: var(--text-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-tertiary {
  color: var(--text-tertiary);
}

.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

.text-right {
  text-align: right;
}

/* 标题 */
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ==================== 卡片 ==================== */

.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1px solid var(--border-color);
  backdrop-filter: blur(10px);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: var(--gradient-primary);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

/* ==================== 按钮 ==================== */

/* 重置微信小程序 button 默认样式 */
button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

button::after {
  border: none;
}

button text {
  display: inline;
  vertical-align: middle;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  border: none;
  outline: none;
  margin: 0;
  line-height: 1.4;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn text {
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
  line-height: 1.4;
}

.btn-icon {
  margin-right: 8rpx;
}

.btn-primary {
  background: var(--gradient-button) !important;
  color: var(--text-white) !important;
  box-shadow: var(--shadow-primary);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: var(--bg-card) !important;
  color: var(--text-primary) !important;
  border: 1px solid var(--border-color) !important;
}

.btn-secondary:active {
  background: var(--bg-card-hover) !important;
}

.btn-success {
  background: linear-gradient(135deg, #7CC4A0 0%, #7AC0A2 100%) !important;
  color: var(--text-white) !important;
}

.btn-outline {
  background-color: transparent !important;
  color: var(--primary-color) !important;
  border: 2rpx solid var(--primary-color) !important;
}

.btn-outline:active {
  background: rgba(220,141,168),0.1) !important;
}

.btn-block {
  width: 100%;
}

.btn-large {
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  border-radius: var(--radius-xl);
}

/* ==================== 输入框 ==================== */

input,
textarea {
  background-color: var(--bg-input);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

input::placeholder,
textarea::placeholder {
  color: var(--text-placeholder);
}

input:focus,
textarea:focus {
  border-color: var(--primary-color);
  background-color: var(--bg-card);
  box-shadow: 0 0 0 4rpx rgba(220,141,168),0.2);
  outline: none;
}

/* ==================== 选择器 ==================== */

picker {
  width: 100%;
}

.picker-view {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
}

/* ==================== 间距工具 ==================== */

.m-0 { margin: 0; }
.m-8 { margin: 16rpx; }
.m-12 { margin: 24rpx; }
.m-16 { margin: 32rpx; }
.m-20 { margin: 40rpx; }

.mt-8 { margin-top: 16rpx; }
.mt-12 { margin-top: 24rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-20 { margin-top: 40rpx; }

.mb-8 { margin-bottom: 16rpx; }
.mb-12 { margin-bottom: 24rpx; }
.mb-16 { margin-bottom: 32rpx; }
.mb-20 { margin-bottom: 40rpx; }

.p-8 { padding: 16rpx; }
.p-12 { padding: 24rpx; }
.p-16 { padding: 32rpx; }
.p-20 { padding: 40rpx; }

/* ==================== 布局工具 ==================== */

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-spacer {
  flex: 1;
}

/* ==================== 动画 ==================== */

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes slideDown {
  from {
    transform: translateY(-40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

@keyframes glow {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(220,141,168),0.25);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(220,141,168),0.45);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease-out;
}

.animate-slideUp {
  animation: slideUp 0.3s ease-out;
}

.animate-slideDown {
  animation: slideDown 0.3s ease-out;
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

.animate-bounce {
  animation: bounce 2s ease-in-out infinite;
}

.animate-glow {
  animation: glow 2s ease-in-out infinite;
}

/* ==================== 分隔线 ==================== */

.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

.divider-vertical {
  width: 2rpx;
  height: 100%;
  background: var(--border-color);
}

/* ==================== 加载状态 ==================== */

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== 标签 ==================== */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(220,141,168),0.12);
  color: var(--primary-color);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  border: 1px solid rgba(220,141,168),0.25);
}

.tag-success {
  background: rgba(143,212,181,0.12);
  color: var(--success-color);
  border-color: rgba(143,212,181,0.25);
}

.tag-warning {
  background: rgba(240,203,138,0.15);
  color: var(--warning-color);
  border-color: rgba(240,203,138,0.3);
}

.tag-info {
  background: rgba(168,184,224,0.12);
  color: var(--info-color);
  border-color: rgba(168,184,224,0.25);
}

/* ==================== 徽章 ==================== */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  background: var(--gradient-primary);
  color: var(--text-white);
  border-radius: var(--radius-full);
  font-size: 20rpx;
  font-weight: 600;
}

/* ==================== 响应式 ==================== */

@media (max-width: 375px) {
  page {
    font-size: 26rpx;
  }

  .title {
    font-size: 40rpx;
  }

  .card {
    padding: 24rpx;
  }
}

@media (min-width: 412px) {
  .container {
    padding: 40rpx;
  }
}

/* ==================== 安全区域 ==================== */

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.bottom-space {
  height: 200rpx;
}
